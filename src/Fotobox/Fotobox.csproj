<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Fotobox</AssemblyName>
    <RootNamespace>Fotobox</RootNamespace>
    <ApplicationIcon>Assets\fotobox.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AssemblyTitle>Fotobox+</AssemblyTitle>
    <Description>Fotobox+ – Webcam-Livebild, Foto per Auslösetaste, Videoclips, Speichern und Drucken</Description>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.5.96" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Lizenzbedingungen der mitgelieferten Windows-ML-/DirectML-Dateien (Weitergabe als „Distributable Code“) liegen dem Paket bei. -->
  <ItemGroup>
    <None Include="$(PkgMicrosoft_Windows_AI_MachineLearning)\license.txt" Link="Lizenzen\WindowsML-Lizenz.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Windows_AI_MachineLearning)\ThirdPartyNotices.txt" Link="Lizenzen\WindowsML-ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\Models\yolox_nano.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\Models\palm_detection_full_inf_post_192x192.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\Models\hand_landmark_sparse_Nx3x224x224.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\Models\face_detection_yunet_2026may.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fotobox.Tests" />
  </ItemGroup>

</Project>
