<UserControl x:Class="Fotobox.Views.Controls.CameraPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Black" ClipToBounds="True">
        <Image x:Name="PreviewImage"
               RenderTransformOrigin="0.5,0.5"
               Stretch="{Binding Stretch, RelativeSource={RelativeSource AncestorType=UserControl}}"
               SnapsToDevicePixels="True" />
        <Border x:Name="StatusOverlay"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="32"
                Padding="28,16"
                CornerRadius="10"
                Background="#99000000"
                IsHitTestVisible="False">
            <TextBlock x:Name="StatusText"
                       Foreground="White"
                       FontSize="22"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="720" />
        </Border>
    </Grid>
</UserControl>
