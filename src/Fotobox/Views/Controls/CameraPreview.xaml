<UserControl x:Class="Fotobox.Views.Controls.CameraPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Black" ClipToBounds="True">
        <!-- Die Spiegelung sitzt auf einem Host mit exakt der Control-Größe: Bei UniformToFill ist das Image selbst
             größer als der Container, seine Mitte wäre nicht die Mitte der Anzeige. Das Image ist ausdrücklich zentriert:
             Mit Stretch-Ausrichtung legt WPF ein überstehendes Image links/oben an, und Overlays (Bart, Zielmarken) rechnen
             mit dem zentrierten Ausschnitt (OverlayMapper). -->
        <Grid x:Name="MirrorHost" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
            <Image x:Name="PreviewImage"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="{Binding Stretch, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   SnapsToDevicePixels="True" />
        </Grid>
        <Border x:Name="StatusOverlay"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="32"
                Padding="28,16"
                CornerRadius="10"
                Background="#99000000"
                IsHitTestVisible="False">
            <TextBlock x:Name="StatusText"
                       Foreground="White"
                       FontSize="22"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="720" />
        </Border>
    </Grid>
</UserControl>
