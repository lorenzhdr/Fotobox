<UserControl x:Class="Fotobox.Views.Admin.TargetStyleSketch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fotobox.Views.Admin"
             xmlns:core="clr-namespace:Fotobox.Core"
             xmlns:conv="clr-namespace:Fotobox.Views.Converters"
             Width="120" Height="68" IsHitTestVisible="False" Focusable="False">

    <!--
        Skizze eines Zielbox-Stils: dunkles Bild mit stilisierter Person und Box in der gewählten Farbe.
        Bewusst fest eingefärbt (wie die Gastansicht), nicht aus den Admin-Paletten.
    -->
    <UserControl.Resources>
        <conv:EnumMatchVisibilityConverter x:Key="KindVis" />
    </UserControl.Resources>

    <Border Width="120" Height="68" CornerRadius="4" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3A4358" Offset="0" />
                <GradientStop Color="#171C2A" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <!-- Stilisierte Person -->
            <Ellipse Width="15" Height="15" Fill="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,17,0,0" />
            <Ellipse Width="38" Height="30" Fill="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,35,0,0" />

            <!-- Box (52 × 52 in der Mitte) -->
            <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0">
                <!-- Kurzes Etikett „TARGET“ über der Box -->
                <Border Height="5" Width="22" Background="{Binding BoxBrush, RelativeSource={RelativeSource AncestorType=local:TargetStyleSketch}}"
                        CornerRadius="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-7,0,0" />

                <!-- Rechteck -->
                <Border BorderThickness="1.5" CornerRadius="1"
                        BorderBrush="{Binding BoxBrush, RelativeSource={RelativeSource AncestorType=local:TargetStyleSketch}}"
                        Visibility="{Binding Kind, RelativeSource={RelativeSource AncestorType=local:TargetStyleSketch}, Converter={StaticResource KindVis}, ConverterParameter={x:Static core:TargetBoxStyle.Rectangle}}" />

                <!-- Ecken (auch beim Stil mit Fadenkreuz) -->
                <Path Data="M0,12 L0,0 L12,0 M40,0 L52,0 L52,12 M52,40 L52,52 L40,52 M12,52 L0,52 L0,40"
                      StrokeThickness="2" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Miter"
                      Stroke="{Binding BoxBrush, RelativeSource={RelativeSource AncestorType=local:TargetStyleSketch}}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=local:TargetStyleSketch}}" Value="{x:Static core:TargetBoxStyle.Corners}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind, RelativeSource={RelativeSource AncestorType=local:TargetStyleSketch}}" Value="{x:Static core:TargetBoxStyle.CornersCrosshair}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <!-- Fadenkreuz -->
                <Path Data="M26,19 L26,33 M19,26 L33,26" StrokeThickness="1.5"
                      Stroke="{Binding BoxBrush, RelativeSource={RelativeSource AncestorType=local:TargetStyleSketch}}"
                      Visibility="{Binding Kind, RelativeSource={RelativeSource AncestorType=local:TargetStyleSketch}, Converter={StaticResource KindVis}, ConverterParameter={x:Static core:TargetBoxStyle.CornersCrosshair}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
