<Window x:Class="Fotobox.Views.Admin.FirstRunPinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fotobox.Views.Admin"
        Title="Fotobox – Willkommen"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="True" Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AdminTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#9AA5B5" BorderThickness="1" Padding="40,34,40,32">
        <StackPanel Orientation="Horizontal">
            <StackPanel Width="360" Margin="0,0,44,0">
                <TextBlock Text="Willkommen bei der Fotobox" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Hint}" FontSize="15" Margin="0,12,0,0"
                           Text="Legen Sie jetzt eine PIN fest, die die Einstellungen schützt. Sie besteht aus 4 bis 12 Ziffern und wird beim Öffnen der Einstellungen abgefragt." />
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
                    <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"
                               Text="Hinweis: Strg+Alt+A öffnet später die Einstellungen." />
                </Border>

                <TextBlock Text="PIN" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PinBox" Style="{StaticResource PinBoxStyle}" />
                <TextBlock Text="PIN wiederholen" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="RepeatBox" Style="{StaticResource PinBoxStyle}" />

                <TextBlock x:Name="MessageText" Foreground="{StaticResource DangerBrush}" FontSize="14"
                           TextWrapping="Wrap" MinHeight="40" Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <local:PinPad x:Name="Pad" SubmitText="Weiter" />
                <Button Content="Abbrechen" Margin="5,12,5,0" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
