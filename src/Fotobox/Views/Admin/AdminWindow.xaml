                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="HintStyle" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding HintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:HintStyle.Note}}"
                                             AutomationProperties.Name="Zettel">
                                    <StackPanel>
                                        <local:HintStyleSketch Kind="Note" />
