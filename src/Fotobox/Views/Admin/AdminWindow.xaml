                                                         IsChecked="{Binding WheelHintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:WheelHintStyle.SmallPill}}"
                                                         AutomationProperties.Name="Mausradzeile: Kleine Pille">
                                                <StackPanel>
                                                    <local:WheelHintSketch Kind="SmallPill" />
                                                    <TextBlock Text="Kleine Pille" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Schmale dunkle Pille mit Goldrand." Style="{StaticResource Hint}" TextAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton GroupName="WheelHintStyle" Style="{StaticResource CardRadio}"
                                                         IsChecked="{Binding WheelHintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:WheelHintStyle.Plain}}"
                                                         AutomationProperties.Name="Mausradzeile: Schlichter Text">
                                                <StackPanel>
                                                    <local:WheelHintSketch Kind="Plain" />
