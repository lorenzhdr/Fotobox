                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="HintStyle" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding HintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:HintStyle.Neon}}"
                                             AutomationProperties.Name="Neon">
                                    <StackPanel>
                                        <local:HintStyleSketch Kind="Neon" />
