<Window x:Class="Fotobox.Views.Admin.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fotobox.Views.Admin"
        xmlns:core="clr-namespace:Fotobox.Core"
        xmlns:vm="clr-namespace:Fotobox.ViewModels.Admin"
        xmlns:controls="clr-namespace:Fotobox.Views.Controls"
        xmlns:booth="clr-namespace:Fotobox.Views.Booth"
        Title="Fotobox+ – Einstellungen"
        Width="1100" Height="750" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AdminColors.Light.xaml" />
                <ResourceDictionary Source="AdminTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" SelectionChanged="OnTabSelectionChanged">

            <!-- ============================== Kamera ============================== -->
            <TabItem Header="Kamera" Tag="&#xE722;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Kamera" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Kamera" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                          DisplayMemberPath="Name" />
                                <TextBlock Text="Auflösung" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}"
                                          DisplayMemberPath="Display" />
                                <TextBlock Text="Bei „Automatisch“ wählt die Fotobox die höchste verfügbare Auflösung."
                                           Style="{StaticResource Hint}" />
                                <TextBlock Text="Spiegeln" Style="{StaticResource FieldLabel}" />
                                <CheckBox Content="Live-Vorschau spiegeln" IsChecked="{Binding MirrorPreview}" />
                                <CheckBox Content="Foto spiegeln" IsChecked="{Binding MirrorPhoto}" />
                                <TextBlock Text="Die Vorschau wirkt wie ein Spiegel, wenn sie gespiegelt ist. Das gespeicherte Foto wird nur gespiegelt, wenn „Foto spiegeln“ aktiv ist."
                                           Style="{StaticResource Hint}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Live-Vorschau" Style="{StaticResource FieldLabel}" Margin="0,50,0,6" />
                                <Border Background="Black" CornerRadius="10" Height="380" ClipToBounds="True">
                                    <controls:CameraPreview Camera="{Binding Camera}" Mirror="{Binding MirrorPreview}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding CameraStatusText}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Ablauf ============================== -->
            <TabItem Header="Ablauf" Tag="&#xE916;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ablauf" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Countdown vor jedem Foto" Style="{StaticResource FieldLabel}" />
                            <local:NumberStepper Value="{Binding CountdownSeconds}" Minimum="{x:Static core:SettingsLimits.CountdownMin}" Maximum="{x:Static core:SettingsLimits.CountdownMax}" Suffix=" s" />

                            <TextBlock Text="Dauer der Vorschau nach dem Foto" Style="{StaticResource FieldLabel}" />
                            <local:NumberStepper Value="{Binding PreviewSeconds}" Minimum="{x:Static core:SettingsLimits.PreviewMin}" Maximum="{x:Static core:SettingsLimits.PreviewMax}" Suffix=" s" />

                            <TextBlock Text="Pause zwischen mehreren Fotos" Style="{StaticResource FieldLabel}" />
                            <local:NumberStepper Value="{Binding PauseBetweenShotsSeconds}" Minimum="{x:Static core:SettingsLimits.PauseMin}" Maximum="{x:Static core:SettingsLimits.PauseMax}" Suffix=" s" />
                            <TextBlock Text="Gilt beim Fotostreifen mit mehreren Aufnahmen." Style="{StaticResource Hint}" />

                            <TextBlock Text="Dauer der Fehleranzeige" Style="{StaticResource FieldLabel}" />
                            <local:NumberStepper Value="{Binding ErrorDisplaySeconds}" Minimum="{x:Static core:SettingsLimits.ErrorDisplayMin}" Maximum="{x:Static core:SettingsLimits.ErrorDisplayMax}" Suffix=" s" />

                            <TextBlock Text="Drucken" Style="{StaticResource FieldLabel}" Margin="0,26,0,6" />
                            <CheckBox Content="Fotos nach der Aufnahme drucken" IsChecked="{Binding PrintingEnabled}" />
                            <TextBlock Text="Ist das Drucken ausgeschaltet, werden die Fotos nur gespeichert."
                                       Style="{StaticResource Hint}" />

                            <TextBlock Text="Erwartete Druckdauer" Style="{StaticResource FieldLabel}" />
                            <local:NumberStepper Value="{Binding ExpectedPrintSeconds}" Minimum="{x:Static core:SettingsLimits.ExpectedPrintMin}" Maximum="{x:Static core:SettingsLimits.ExpectedPrintMax}" Step="10" Suffix=" s" />
                            <TextBlock Text="{Binding ExpectedPrintHint}"
                                       Style="{StaticResource Hint}" />
                            <TextBlock Text="{Binding PrintTimeoutHint}" Style="{StaticResource Hint}" Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding HasPrintTimeoutHint, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Video ============================== -->
            <TabItem Header="Video" Tag="&#xE714;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                            <TextBlock Text="Video" Style="{StaticResource SectionTitle}" />

                            <CheckBox Content="Videomodus aktiv" IsChecked="{Binding VideoEnabled}" Margin="0,12,0,0"
                                      FontWeight="SemiBold" AutomationProperties.Name="Videomodus aktiv" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Gäste können dann mit den Tasten „Video starten“ und „Video beenden“ (Tab „Tasten“) ein Video aufnehmen. Videos werden nur gespeichert, nicht angezeigt oder gedruckt." />
                            <TextBlock Text="{Binding VideoStartKeyHint}" Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding HasVideoStartKeyHint, Converter={StaticResource BoolToVis}}" />

                            <!-- Alles Weitere ist bei ausgeschaltetem Videomodus ausgegraut. -->
                            <StackPanel x:Name="VideoSettingsPanel" IsEnabled="{Binding VideoEnabled}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Höchstdauer eines Videos" Style="{StaticResource FieldLabel}" />
                                <local:NumberStepper Value="{Binding VideoMaxDurationSeconds}" Minimum="{x:Static core:SettingsLimits.VideoMaxDurationMin}" Maximum="{x:Static core:SettingsLimits.VideoMaxDurationMax}" Step="10" Suffix=" s" />
                                <TextBlock Text="{Binding VideoMaxDurationText}" Style="{StaticResource Hint}" />

                                <TextBlock Text="Countdown vor dem Video" Style="{StaticResource FieldLabel}" />
                                <local:NumberStepper Value="{Binding VideoCountdownSeconds}" Minimum="{x:Static core:SettingsLimits.VideoCountdownMin}" Maximum="{x:Static core:SettingsLimits.VideoCountdownMax}" Suffix=" s" />
                                <TextBlock Text="Bei 0 beginnt die Aufnahme sofort." Style="{StaticResource Hint}" />

                                <TextBlock Text="Mindestlänge" Style="{StaticResource FieldLabel}" />
                                <local:NumberStepper Value="{Binding VideoMinDurationSeconds}" Minimum="{x:Static core:SettingsLimits.VideoMinDurationMin}" Maximum="{x:Static core:SettingsLimits.VideoMinDurationMax}" Suffix=" s" />
                                <TextBlock Text="So lange läuft die Aufnahme mindestens; ein früheres „Video beenden“ wird ignoriert. Die Mindestlänge muss kürzer sein als die Höchstdauer."
                                           Style="{StaticResource Hint}" />

                                <TextBlock Text="Videoqualität" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding VideoQualities}" SelectedItem="{Binding SelectedVideoQuality}"
                                          DisplayMemberPath="Display" AutomationProperties.Name="Videoqualität" />

                                <!-- Anzeige während der Aufnahme -->
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,24,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Anzeige während der Aufnahme" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <CheckBox Content="Roter Aufnahmepunkt" IsChecked="{Binding VideoShowRecDot}" Margin="0,10,0,0" />
                                        <CheckBox Content="Laufzeit" IsChecked="{Binding VideoShowElapsed}" />
                                        <CheckBox Content="Restzeit" IsChecked="{Binding VideoShowRemaining}" />

                                        <TextBlock Text="Warnung vor dem Ende ab … Sekunden (0 = aus)" Style="{StaticResource FieldLabel}" />
                                        <local:NumberStepper Value="{Binding VideoWarningSeconds}" Minimum="{x:Static core:SettingsLimits.VideoWarningMin}" Maximum="{x:Static core:SettingsLimits.VideoWarningMax}" Step="5" Suffix=" s" />
                                        <TextBlock Text="Ab dieser Restzeit weist die Gastansicht darauf hin, dass die Aufnahme gleich endet." Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Border>

                                <!-- Nach der Aufnahme -->
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Nach der Aufnahme" Style="{StaticResource FieldLabel}" Margin="0" />

                                        <TextBlock Text="Text nach dem Speichern" Style="{StaticResource FieldLabel}" />
                                        <Grid HorizontalAlignment="Left" Width="520">
                                            <TextBox Text="{Binding VideoSuccessText, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="{x:Static core:SettingsLimits.VideoSuccessTextMaxLength}"
                                                     AutomationProperties.Name="Text nach dem Speichern" />
                                            <!-- Platzhalter: der Standardtext, solange das Feld leer ist -->
                                            <TextBlock Text="{Binding VideoSuccessTextPlaceholder}" IsHitTestVisible="False"
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="15"
                                                       VerticalAlignment="Center" Margin="12,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VideoSuccessText}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="Leer lassen für den Standardtext. Die Gastansicht zeigt ihn nach jedem gespeicherten Video." Style="{StaticResource Hint}" />

                                        <TextBlock Text="Anzeigedauer" Style="{StaticResource FieldLabel}" />
                                        <local:NumberStepper Value="{Binding VideoSuccessDisplaySeconds}" Minimum="{x:Static core:SettingsLimits.VideoSuccessDisplayMin}" Maximum="{x:Static core:SettingsLimits.VideoSuccessDisplayMax}" Suffix=" s" />
                                    </StackPanel>
                                </Border>

                                <!-- Ton -->
                                <TextBlock Text="Ton" Style="{StaticResource FieldLabel}" Margin="0,24,0,6" />
                                <CheckBox Content="Ton aufnehmen" IsChecked="{Binding VideoRecordAudio}" />
                                <TextBlock Text="Mikrofon" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                                          DisplayMemberPath="Display" IsEnabled="{Binding VideoRecordAudio}"
                                          AutomationProperties.Name="Mikrofon" />
                                <TextBlock Text="{Binding MicrophoneHint}" Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}"
                                           Visibility="{Binding HasMicrophoneHint, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Fehlt das Mikrofon oder ist der Zugriff in Windows gesperrt, wird ohne Ton aufgenommen. Eine Änderung beim Ton wirkt nach „Speichern“ (die Kamera startet dabei kurz neu)." />

                                <!-- Speicherort -->
                                <TextBlock Text="Speicherordner der Videos" Style="{StaticResource FieldLabel}" Margin="0,24,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding VideoFolderDisplay, Mode=OneWay}" IsReadOnly="True"
                                             AutomationProperties.Name="Speicherordner der Videos" />
                                    <Button Grid.Column="1" Content="Ändern …" Command="{Binding ChooseVideoFolderCommand}" Margin="10,0,0,0" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Ordner öffnen" Command="{Binding OpenVideoFolderCommand}" />
                                    <Button Content="Standardordner verwenden" Command="{Binding ResetVideoFolderCommand}" Margin="10,0,0,0" />
                                </StackPanel>

                                <CheckBox Content="Unterordner pro Tag anlegen (JJJJ-MM-TT)" IsChecked="{Binding VideoDateSubfolder}" Margin="0,18,0,0" />

                                <TextBlock Text="Dateipräfix der Videos" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding VideoFilePrefix, UpdateSourceTrigger=PropertyChanged}" MaxLength="{x:Static core:SettingsLimits.FilePrefixMaxLength}"
                                         HorizontalAlignment="Left" Width="320" AutomationProperties.Name="Dateipräfix der Videos" />
                                <TextBlock Text="{Binding VideoFileNameExample}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Layout ============================== -->
            <TabItem Header="Layout" Tag="&#xE8A9;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Layout" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Standard-Layout" Style="{StaticResource FieldLabel}" />

                            <UniformGrid Columns="3" Margin="0,0,-14,0">
                                <RadioButton GroupName="LayoutKind" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding IsSingleLayout}"
                                             AutomationProperties.Name="Einzelfoto randlos">
                                    <StackPanel>
                                        <Border Width="64" Height="92" Background="White" BorderBrush="#9AA5B5" BorderThickness="1.5" CornerRadius="3">
                                            <Border Background="#7CA2E8" Margin="0" />
                                        </Border>
                                        <TextBlock Text="Einzelfoto randlos" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Ein Foto füllt die ganze Seite." Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="LayoutKind" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding IsStripLayout}"
                                             AutomationProperties.Name="Fotostreifen">
                                    <StackPanel>
                                        <Border Width="64" Height="92" Background="White" BorderBrush="#9AA5B5" BorderThickness="1.5" CornerRadius="3" Padding="7">
                                            <UniformGrid Rows="3">
                                                <Border Background="#7CA2E8" Margin="0,0,0,4" />
                                                <Border Background="#7CA2E8" Margin="0,0,0,4" />
                                                <Border Background="#7CA2E8" />
                                            </UniformGrid>
                                        </Border>
                                        <TextBlock Text="Fotostreifen" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StripPhotosHint}" Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="LayoutKind" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding IsOverlayLayout}"
                                             AutomationProperties.Name="Foto mit Overlay">
                                    <StackPanel>
                                        <Border Width="64" Height="92" Background="White" BorderBrush="#9AA5B5" BorderThickness="1.5" CornerRadius="3" Padding="0">
                                            <Grid>
                                                <Border Background="#7CA2E8" />
                                                <Border BorderBrush="#E8B64A" BorderThickness="6" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="Foto mit Overlay" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Foto mit eigener PNG-Grafik darüber." Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <TextBlock Text="Auswahl für Gäste (Mausrad)" Style="{StaticResource FieldLabel}" />
                            <CheckBox Content="Ein Foto (Vollbild)" IsChecked="{Binding IsGuestSingle}"
                                      IsEnabled="{Binding IsGuestSingleEnabled}" Margin="0,4" />
                            <CheckBox Content="Fotostreifen – 2 Streifen nebeneinander" IsChecked="{Binding IsGuestStripDouble}"
                                      IsEnabled="{Binding IsGuestStripDoubleEnabled}" Margin="0,4" />
                            <CheckBox Content="Fotostreifen – 1 Streifen" IsChecked="{Binding IsGuestStripSingle}"
                                      IsEnabled="{Binding IsGuestStripSingleEnabled}" Margin="0,4" />
                            <CheckBox Content="Foto mit Overlay" IsChecked="{Binding IsGuestOverlay}"
                                      IsEnabled="{Binding IsGuestOverlayEnabled}" Margin="0,4" />
                            <TextBlock Text="Mit mindestens zwei Einträgen können Gäste in der Gastansicht per Mausrad wechseln. Nach jedem Foto gilt wieder das Standard-Layout."
                                       Style="{StaticResource Hint}" />

                            <StackPanel Visibility="{Binding HasGuestOrder, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Reihenfolge beim Scrollen" Style="{StaticResource FieldLabel}" />
                                <ItemsControl ItemsSource="{Binding GuestOrder}" MaxWidth="580" HorizontalAlignment="Left">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontWeight="SemiBold" FontSize="15"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="★ Standard" FontWeight="SemiBold" FontSize="15"
                                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               AutomationProperties.Name="Standard-Layout"
                                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" />
                                                    <Button Grid.Column="2" Content="☆" Command="{Binding MakeDefaultCommand}" MinWidth="40" Padding="0,4"
                                                            Margin="8,0,0,0" HorizontalAlignment="Left"
                                                            ToolTip="Als Standard festlegen" AutomationProperties.Name="Als Standard festlegen"
                                                            Visibility="{Binding IsNotDefault, Converter={StaticResource BoolToVis}}" />
                                                    <Button Grid.Column="3" Content="▲" Command="{Binding MoveUpCommand}" MinWidth="40" Padding="0,4"
                                                            Margin="8,0,0,0" ToolTip="Nach oben" AutomationProperties.Name="Nach oben" />
                                                    <Button Grid.Column="4" Content="▼" Command="{Binding MoveDownCommand}" MinWidth="40" Padding="0,4"
                                                            Margin="6,0,0,0" ToolTip="Nach unten" AutomationProperties.Name="Nach unten" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Gäste scrollen in dieser Reihenfolge durch die Layouts (am Ende geht es wieder von vorn los). Der Eintrag mit ★ ist der Standard: Damit startet die Gastansicht, und nach jedem Foto gilt er wieder. Mit ☆ legen Sie einen anderen Eintrag als Standard fest."
                                           Style="{StaticResource Hint}" />
                                <CheckBox Content="Mausrad-Richtung umkehren" IsChecked="{Binding InvertMouseWheel}" Margin="0,10,0,0" />
                                <TextBlock Text="Ohne Haken wählt Scrollen nach oben das vorherige Layout (Markierung wandert nach oben), mit Haken das nächste."
                                           Style="{StaticResource Hint}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowStripOptions, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Anzahl der Fotos im Streifen" Style="{StaticResource FieldLabel}" />
                                <local:NumberStepper Value="{Binding StripPhotoCount}" Minimum="{x:Static core:SettingsLimits.StripPhotosMin}" Maximum="{x:Static core:SettingsLimits.StripPhotosMax}" Suffix=" Fotos" />
                                <TextBlock Text="Fotostreifen werden immer im Hochformat gedruckt." Style="{StaticResource Hint}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsStripLayout, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Variante des Fotostreifens" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="StripStyle" Style="{StaticResource CardRadio}" Width="250"
                                                 IsChecked="{Binding IsStripDoubleCut}"
                                                 AutomationProperties.Name="2 Streifen nebeneinander">
                                        <StackPanel>
                                            <Border Width="64" Height="92" Background="White" BorderBrush="#9AA5B5" BorderThickness="1.5" CornerRadius="3" Padding="7">
                                                <UniformGrid Columns="2">
                                                    <UniformGrid Rows="3" Margin="0,0,3,0">
                                                        <Border Background="#7CA2E8" Margin="0,0,0,3" />
                                                        <Border Background="#7CA2E8" Margin="0,0,0,3" />
                                                        <Border Background="#7CA2E8" />
                                                    </UniformGrid>
                                                    <UniformGrid Rows="3" Margin="3,0,0,0">
                                                        <Border Background="#7CA2E8" Margin="0,0,0,3" />
                                                        <Border Background="#7CA2E8" Margin="0,0,0,3" />
                                                        <Border Background="#7CA2E8" />
                                                    </UniformGrid>
                                                </UniformGrid>
                                            </Border>
                                            <TextBlock Text="2 Streifen nebeneinander (zum Teilen)" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2"
                                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="StripStyle" Style="{StaticResource CardRadio}" Width="250"
                                                 IsChecked="{Binding IsStripSingle}"
                                                 AutomationProperties.Name="1 Streifen">
                                        <StackPanel>
                                            <Border Width="64" Height="92" Background="White" BorderBrush="#9AA5B5" BorderThickness="1.5" CornerRadius="3" Padding="7">
                                                <UniformGrid Rows="3">
                                                    <Border Background="#7CA2E8" Margin="0,0,0,3" />
                                                    <Border Background="#7CA2E8" Margin="0,0,0,3" />
                                                    <Border Background="#7CA2E8" />
                                                </UniformGrid>
                                            </Border>
                                            <TextBlock Text="1 Streifen – Fotos untereinander, ganze Seite" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2"
                                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowOverlayOptions, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Overlay (PNG)" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="90" Height="120" CornerRadius="6" BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1" Background="{DynamicResource ThumbBgBrush}" Margin="0,0,16,0">
                                        <Image Source="{Binding OverlayThumbnail}" Stretch="Uniform" Margin="3" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" MaxWidth="460">
                                        <TextBlock Text="{Binding OverlayInfo}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="PNG auswählen …" Command="{Binding ChooseOverlayCommand}" />
                                            <Button Content="Entfernen" Command="{Binding RemoveOverlayCommand}" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding OverlayHint}" Style="{StaticResource Hint}" />
                            </StackPanel>

                            <TextBlock Text="Bildunterschrift" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CaptionText, UpdateSourceTrigger=PropertyChanged}" MaxLength="{x:Static core:SettingsLimits.CaptionMaxLength}" Width="520"
                                     HorizontalAlignment="Left" />
                            <TextBlock Text="Optionaler Text auf dem Ausdruck, zum Beispiel „Hochzeit Anna &amp; Ben“." Style="{StaticResource Hint}" />

                            <TextBlock Text="Schriftart der Bildunterschrift" Style="{StaticResource FieldLabel}" />
                            <!-- Virtualisiert: Systeme haben Hunderte Schriften; nur die sichtbaren Einträge werden erzeugt.
                                 Tippen springt zum Eintrag (TextSearch über den Anzeigenamen). -->
                            <ComboBox ItemsSource="{Binding CaptionFonts}" SelectedItem="{Binding SelectedCaptionFont}"
                                      Width="520" HorizontalAlignment="Left" MaxDropDownHeight="360"
                                      IsTextSearchEnabled="True" TextSearch.TextPath="Display"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      AutomationProperties.Name="Schriftart der Bildunterschrift">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" FontFamily="{Binding Family}" FontSize="18" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{x:Static vm:AdminViewModel.CaptionFontMissingHint}" Style="{StaticResource Hint}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding IsCaptionFontMissing, Converter={StaticResource BoolToVis}}" />
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12"
                                    Margin="0,10,0,0" Width="520" HorizontalAlignment="Left" Background="{DynamicResource SubtleBrush}">
                                <TextBlock Text="{Binding CaptionPreviewText}" FontFamily="{Binding CaptionPreviewFont}" FontSize="26"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                            </Border>

                            <CheckBox Content="Datum auf dem Ausdruck anzeigen" IsChecked="{Binding ShowDate}" Margin="0,18,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Gastansicht ============================== -->
            <TabItem Header="Gastansicht" Tag="&#xE7F4;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="Gastansicht" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Foto-Hinweis (unten)" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" />

                            <TextBlock Text="Hinweistext" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding HintText, UpdateSourceTrigger=PropertyChanged}" MaxLength="{x:Static core:SettingsLimits.HintTextMaxLength}"
                                     Width="620" HorizontalAlignment="Left" AutomationProperties.Name="Hinweistext" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Leer lassen für den automatischen Text. Platzhalter: {Fototaste_1}, {Fototaste_2} … (einzelne Fototaste), {Fototasten} (alle Fototasten), {Klick} („oder klicke“, wenn ein Mausklick auslöst), außerdem {Videotaste_1}, {Videotasten} (Tasten für „Video starten“)." />
                            <TextBlock Text="{Binding HintProblemsText}" Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding HasHintProblems, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="Darstellung" Style="{StaticResource FieldLabel}" />
                            <UniformGrid Columns="3" Margin="0,0,-14,0">
                                <RadioButton GroupName="HintStyle" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding IsHintPill}"
                                             AutomationProperties.Name="Pille">
                                    <StackPanel>
                                        <Border Width="120" Height="68" CornerRadius="4" ClipToBounds="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#5A6478" Offset="0" />
                                                    <GradientStop Color="#2B3347" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9"
                                                    Width="82" Height="18" CornerRadius="9" BorderThickness="1.2"
                                                    BorderBrush="#F5C26B" Background="#3A1F52">
                                                <Border Height="3" Width="50" Background="White" CornerRadius="1.5" />
                                            </Border>
                                        </Border>
                                        <TextBlock Text="Pille" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Goldener Rahmen, pulsiert sanft." Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="HintStyle" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding IsHintPlain}"
                                             AutomationProperties.Name="Schlicht">
                                    <StackPanel>
                                        <Border Width="120" Height="68" CornerRadius="4" ClipToBounds="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#5A6478" Offset="0" />
                                                    <GradientStop Color="#2B3347" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border Height="4" Width="62" Background="White" CornerRadius="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" />
                                        </Border>
                                        <TextBlock Text="Schlicht" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Weißer Text mit Schatten." Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="HintStyle" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding IsHintBanner}"
                                             AutomationProperties.Name="Banner">
                                    <StackPanel>
                                        <Border Width="120" Height="68" CornerRadius="4" ClipToBounds="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#5A6478" Offset="0" />
                                                    <GradientStop Color="#2B3347" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border VerticalAlignment="Bottom" Height="26" Background="#CC101828"
                                                    BorderBrush="#F5C26B" BorderThickness="0,1.2,0,0">
                                                <Border Height="4" Width="62" Background="White" CornerRadius="2" />
                                            </Border>
                                        </Border>
                                        <TextBlock Text="Banner" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Dunkles Band über die ganze Breite." Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- Video-Hinweis (oben im Bild) -->
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,22,0,0">
                                <StackPanel x:Name="VideoHintPanel" IsEnabled="{Binding VideoEnabled}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="Video-Hinweis (oben)" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Eigene Zeile oben im Bild, die auf die Videoaufnahme hinweist. Sie erscheint nur bei aktivem Videomodus (Tab „Video“)." />

                                    <TextBlock Text="Video-Hinweistext" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding VideoHintText, UpdateSourceTrigger=PropertyChanged}" MaxLength="{x:Static core:SettingsLimits.HintTextMaxLength}"
                                             Width="620" HorizontalAlignment="Left" AutomationProperties.Name="Video-Hinweistext" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Leer lassen für den automatischen Text. Platzhalter: {Videotaste_1}, {Videotaste_2} … (einzelne Videotaste), {Videotasten} (alle Tasten für „Video starten“), dazu {Fototaste_N}, {Fototasten} und {Klick} wie beim Foto-Hinweis. Ohne Taste für „Video starten“ entfällt die Zeile." />
                                    <TextBlock Text="{Binding VideoHintProblemsText}" Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}"
                                               Visibility="{Binding HasVideoHintProblems, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Text="Darstellung" Style="{StaticResource FieldLabel}" />
                                    <UniformGrid Columns="3" Margin="0,0,-14,0">
                                        <RadioButton GroupName="VideoHintStyle" Style="{StaticResource CardRadio}"
                                                     IsChecked="{Binding IsVideoHintPill}"
                                                     AutomationProperties.Name="Video-Hinweis: Pille">
                                            <StackPanel>
                                                <Border Width="120" Height="68" CornerRadius="4" ClipToBounds="True">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#5A6478" Offset="0" />
                                                            <GradientStop Color="#2B3347" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9,0,0"
                                                            Width="82" Height="18" CornerRadius="9" BorderThickness="1.2"
                                                            BorderBrush="#F5C26B" Background="#3A1F52">
                                                        <Border Height="3" Width="50" Background="White" CornerRadius="1.5" />
                                                    </Border>
                                                </Border>
                                                <TextBlock Text="Pille" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                <TextBlock Text="Goldener Rahmen, pulsiert sanft." Style="{StaticResource Hint}" TextAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="VideoHintStyle" Style="{StaticResource CardRadio}"
                                                     IsChecked="{Binding IsVideoHintPlain}"
                                                     AutomationProperties.Name="Video-Hinweis: Schlicht">
                                            <StackPanel>
                                                <Border Width="120" Height="68" CornerRadius="4" ClipToBounds="True">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#5A6478" Offset="0" />
                                                            <GradientStop Color="#2B3347" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border Height="4" Width="62" Background="White" CornerRadius="2"
                                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" />
                                                </Border>
                                                <TextBlock Text="Schlicht" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                <TextBlock Text="Weißer Text mit Schatten." Style="{StaticResource Hint}" TextAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="VideoHintStyle" Style="{StaticResource CardRadio}"
                                                     IsChecked="{Binding IsVideoHintBanner}"
                                                     AutomationProperties.Name="Video-Hinweis: Banner">
                                            <StackPanel>
                                                <Border Width="120" Height="68" CornerRadius="4" ClipToBounds="True">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#5A6478" Offset="0" />
                                                            <GradientStop Color="#2B3347" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border VerticalAlignment="Top" Height="26" Background="#CC101828"
                                                            BorderBrush="#F5C26B" BorderThickness="0,0,0,1.2">
                                                        <Border Height="4" Width="62" Background="White" CornerRadius="2" />
                                                    </Border>
                                                </Border>
                                                <TextBlock Text="Banner" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                <TextBlock Text="Dunkles Band über die ganze Breite." Style="{StaticResource Hint}" TextAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Vorschau" Style="{StaticResource FieldLabel}" />
                            <!-- Die Gastansicht im Maßstab 1:3 (1920 × 1080): derselbe Hinweis wie am Gerät, mit angedeutetem Livebild -->
                            <Border Width="642" Height="362" HorizontalAlignment="Left" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    AutomationProperties.Name="Vorschau der Gastansicht">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="1920" Height="1080" ClipToBounds="True">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#566077" Offset="0" />
                                                <GradientStop Color="#232A3B" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <!-- Angedeutete Person als Platzhalter für das Livebild -->
                                        <Ellipse Width="270" Height="270" Fill="#2EFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,170,0,0" />
                                        <Ellipse Width="780" Height="620" Fill="#2EFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,470,0,0" />
                                        <!-- Wie in der Gastansicht: dezenter Verlauf unten für die Lesbarkeit -->
                                        <Border VerticalAlignment="Bottom" Height="320">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0" />
                                                    <GradientStop Color="#B0000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <booth:GuestHint Text="{Binding HintPreviewText}" HintStyle="{Binding HintStyle}"
                                                         LayoutHintText="{Binding HintPreviewLayoutText}" ShowLayoutHint="{Binding HasGuestOrder}" />
                                        <!-- Video-Zeile oben im Bild (nur bei aktivem Videomodus und vorhandener Starttaste) -->
                                        <booth:GuestHint Text="{Binding VideoHintPreviewText}" HintStyle="{Binding VideoHintStyle}"
                                                         Position="Top" x:Name="VideoHintPreview"
                                                         Visibility="{Binding ShowVideoHintPreview, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Viewbox>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Die Vorschau zeigt den Hinweis mit den aktuell eingestellten Fototasten (Tab „Tasten“) und, wenn Gäste per Mausrad zwischen mehreren Layouts wählen können, die Zeile zur Layoutwahl. Bei aktivem Videomodus erscheint oben die Video-Zeile. Das Livebild ist nur angedeutet." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Darstellung ============================== -->
            <TabItem Header="Darstellung" Tag="&#xE790;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="Darstellung" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Monitor der Gastansicht" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}"
                                      DisplayMemberPath="Display" IsEnabled="{Binding IsMonitorSelectable}"
                                      AutomationProperties.Name="Monitor der Gastansicht" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding MonitorHint}"
                                       Visibility="{Binding HasMonitorHint, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="Farbschema der Einstellungen" Style="{StaticResource FieldLabel}" />
                            <!-- Die Skizzen zeigen das jeweilige Schema und sind deshalb fest eingefärbt. -->
                            <UniformGrid Columns="3" Margin="0,0,-14,0">
                                <RadioButton GroupName="AdminTheme" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding IsAdminThemeSystem}"
                                             AutomationProperties.Name="Wie Windows">
                                    <StackPanel>
                                        <Grid Width="120" Height="68">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F3F5F9" BorderBrush="#9AA5B5" BorderThickness="1.5,1.5,0,1.5"
                                                    CornerRadius="4,0,0,4" Padding="8,10,4,10">
                                                <StackPanel>
                                                    <Border Height="5" Background="#1B2430" CornerRadius="2" Margin="0,0,10,6" />
                                                    <Border Height="5" Background="#2563EB" CornerRadius="2" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#14171D" BorderBrush="#9AA5B5" BorderThickness="0,1.5,1.5,1.5"
                                                    CornerRadius="0,4,4,0" Padding="4,10,8,10">
                                                <StackPanel>
                                                    <Border Height="5" Background="#E6EAF0" CornerRadius="2" Margin="0,0,10,6" />
                                                    <Border Height="5" Background="#4C8DFF" CornerRadius="2" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Wie Windows" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Folgt dem App-Modus von Windows." Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="AdminTheme" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding IsAdminThemeLight}"
                                             AutomationProperties.Name="Hell">
                                    <StackPanel>
                                        <Border Width="120" Height="68" Background="#F3F5F9" BorderBrush="#9AA5B5" BorderThickness="1.5"
                                                CornerRadius="4" Padding="10">
                                            <StackPanel>
                                                <Border Height="5" Background="#1B2430" CornerRadius="2" Margin="0,0,40,6" />
                                                <Border Height="5" Background="#5F6B7C" CornerRadius="2" Margin="0,0,20,6" />
                                                <Border Height="5" Background="#2563EB" CornerRadius="2" Margin="0,0,56,0" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Hell" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Immer helles Schema." Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="AdminTheme" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding IsAdminThemeDark}"
                                             AutomationProperties.Name="Dunkel">
                                    <StackPanel>
                                        <Border Width="120" Height="68" Background="#14171D" BorderBrush="#9AA5B5" BorderThickness="1.5"
                                                CornerRadius="4" Padding="10">
                                            <StackPanel>
                                                <Border Height="5" Background="#E6EAF0" CornerRadius="2" Margin="0,0,40,6" />
                                                <Border Height="5" Background="#A3ADBC" CornerRadius="2" Margin="0,0,20,6" />
                                                <Border Height="5" Background="#4C8DFF" CornerRadius="2" Margin="0,0,56,0" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Dunkel" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Immer dunkles Schema." Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Das Farbschema gilt für die Einstellungen und die PIN-Abfrage, nicht für die Gastansicht. Die Änderung ist sofort sichtbar und wird mit „Speichern“ übernommen." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Drucker ============================== -->
            <TabItem Header="Drucker" Tag="&#xE749;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="Drucker" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Drucker" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                                      DisplayMemberPath="Display" />

                            <TextBlock Text="Papiergröße" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding SelectedPaper}"
                                      DisplayMemberPath="Display" />
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                                <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"
                                           Text="Für randlosen Druck wählen Sie hier die randlose Papiergröße Ihres Fotodruckers (zum Beispiel „10 x 15 cm randlos“)." />
                            </Border>

                            <TextBlock Text="Ausrichtung" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding SelectedOrientation}"
                                      DisplayMemberPath="Display" />

                            <TextBlock Text="Anzahl der Kopien" Style="{StaticResource FieldLabel}" />
                            <local:NumberStepper Value="{Binding Copies}" Minimum="{x:Static core:SettingsLimits.CopiesMin}" Maximum="{x:Static core:SettingsLimits.CopiesMax}" Suffix=" ×" />

                            <TextBlock Text="Zeitlimit für den Druck" Style="{StaticResource FieldLabel}" />
                            <local:NumberStepper Value="{Binding PrintTimeoutSeconds}" Minimum="{x:Static core:SettingsLimits.PrintTimeoutMin}" Maximum="{x:Static core:SettingsLimits.PrintTimeoutMax}" Step="10" Suffix=" s" />
                            <TextBlock Text="Nach dieser Zeit meldet die Fotobox einen Druckfehler und ist wieder bereit."
                                       Style="{StaticResource Hint}" />
                            <TextBlock Text="{Binding PrintTimeoutHint}" Style="{StaticResource Hint}" Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding HasPrintTimeoutHint, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="Testdruck" Style="{StaticResource FieldLabel}" Margin="0,26,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Testseite drucken" Command="{Binding TestPrintCommand}" Style="{StaticResource PrimaryButton}" />
                                <TextBlock Text="{Binding TestPrintStatus}" VerticalAlignment="Center" Margin="16,0,0,0"
                                           FontSize="14" TextWrapping="Wrap" MaxWidth="360" />
                            </StackPanel>
                            <TextBlock Text="Druckt eine Testseite mit Rahmen und Raster in der gewählten Papiergröße (mit den aktuellen, noch nicht gespeicherten Einstellungen)."
                                       Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Tasten ============================== -->
            <TabItem Header="Tasten" Tag="&#xE765;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Tasten" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Legen Sie fest, mit welchen Tasten die Fotobox bedient wird. Jede Taste kann nur einer Aktion zugeordnet werden; nur „Video starten“ und „Video beenden“ dürfen sich dieselbe Taste teilen." />

                            <ItemsControl ItemsSource="{Binding KeyEditors}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12"
                                                Padding="18,14" Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource FieldLabel}" Margin="0" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" />

                                                <ItemsControl ItemsSource="{Binding Keys}" Margin="0,12,0,0" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10"
                                                                    Padding="14,2,2,2" Margin="0,0,10,8">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                                    <Button Content="&#xE711;" Command="{Binding RemoveCommand}"
                                                                            Style="{StaticResource ChipRemoveButton}"
                                                                            ToolTip="Taste entfernen" AutomationProperties.Name="Taste entfernen" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="Taste hinzufügen" Command="{Binding AddKeyCommand}"
                                                        HorizontalAlignment="Left" Margin="0,4,0,0" />

                                                <!-- Maus: gehört nur zur Aktion „Foto auslösen“ -->
                                                <StackPanel Margin="0,10,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Action}" Value="Trigger">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <CheckBox Content="Linke Maustaste löst aus"
                                                              IsChecked="{Binding DataContext.TriggerOnLeftClick, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <CheckBox Content="Rechte Maustaste löst aus"
                                                              IsChecked="{Binding DataContext.TriggerOnRightClick, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </StackPanel>

                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0"
                                                        Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"
                                                                   Text="Drücken Sie jetzt die gewünschte Taste (auch mit Strg/Alt/Umschalt) …" />
                                                        <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                                                                   Text="{Binding DataContext.KeyMessage, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <Button Content="Abbrechen" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                                Command="{Binding DataContext.CancelKeyCaptureCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding VideoStartKeyHint}" Style="{StaticResource Hint}" Margin="0,12,0,0"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding HasVideoStartKeyHint, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding KeyMessage}" Style="{StaticResource Hint}" Margin="0,12,0,0"
                                       Visibility="{Binding ShowKeyMessageBelow, Converter={StaticResource BoolToVis}}" />

                            <Button Content="Standard wiederherstellen" Command="{Binding ResetKeysCommand}"
                                    HorizontalAlignment="Left" Margin="0,18,0,0" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="„Foto auslösen“ und „Admin-Ansicht öffnen“ behalten immer mindestens eine Taste. Die Änderungen gelten nach „Speichern“." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Speicher ============================== -->
            <TabItem Header="Speicher" Tag="&#xE8B7;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="Speicher" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Speicherordner" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PhotoFolderDisplay, Mode=OneWay}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Ändern …" Command="{Binding ChooseFolderCommand}" Margin="10,0,0,0" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Ordner öffnen" Command="{Binding OpenFolderCommand}" />
                                <Button Content="Standardordner verwenden" Command="{Binding ResetFolderCommand}" Margin="10,0,0,0" />
                            </StackPanel>

                            <CheckBox Content="Unterordner pro Tag anlegen (JJJJ-MM-TT)" IsChecked="{Binding DateSubfolder}" Margin="0,22,0,0" />
                            <CheckBox Content="Einzelne Originalfotos zusätzlich speichern" IsChecked="{Binding SaveOriginals}" />

                            <TextBlock Text="JPEG-Qualität" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="340" Minimum="{Binding Source={x:Static core:SettingsLimits.JpegQualityMin}, Mode=OneTime}"
                                        Maximum="{Binding Source={x:Static core:SettingsLimits.JpegQualityMax}, Mode=OneTime}" TickFrequency="1" SmallChange="1" LargeChange="5"
                                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                        Value="{Binding JpegQuality}" />
                                <TextBlock Text="{Binding JpegQualityText}" FontSize="16" FontWeight="SemiBold" Margin="16,0,0,0"
                                           VerticalAlignment="Center" MinWidth="60" />
                            </StackPanel>

                            <TextBlock Text="Dateipräfix" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FilePrefix, UpdateSourceTrigger=PropertyChanged}" MaxLength="{x:Static core:SettingsLimits.FilePrefixMaxLength}" MaxWidth="320"
                                     HorizontalAlignment="Left" Width="320" />
                            <TextBlock Text="Dateien heißen zum Beispiel „Fotobox_20250101_120000.jpg“." Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Sicherheit ============================== -->
            <TabItem Header="Sicherheit" Tag="&#xE72E;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="Sicherheit" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding AdminKeysDisplay, StringFormat='Mit {0} öffnen Sie diese Einstellungen. Der Zugang ist durch eine PIN geschützt.'}"
                                       Style="{StaticResource Hint}" />

                            <TextBlock Text="{Binding Source={x:Static core:PinRules.LengthText}, StringFormat='Neue PIN ({0})'}" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="NewPinBox" PasswordChanged="OnNewPinChanged" />
                            <TextBlock Text="Neue PIN wiederholen" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="RepeatPinBox" PasswordChanged="OnRepeatPinChanged" />

                            <Button Content="PIN ändern" Command="{Binding ChangePinCommand}" Margin="0,18,0,0"
                                    HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
                            <TextBlock Text="{Binding PinStatus}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Die PIN wird sofort geändert. Haben Sie die Felder ausgefüllt und klicken auf „Speichern“, wird die neue PIN ebenfalls übernommen." />

                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="Standardwerte" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Setzt alle Einstellungen außer der PIN zurück. Fotos und Overlay-Dateien bleiben erhalten. Die Änderung gilt erst nach „Speichern“." />
                                    <Button Content="Standardwerte wiederherstellen …" Command="{Binding ResetToDefaultsCommand}"
                                            HorizontalAlignment="Left" Margin="0,14,0,0"
                                            AutomationProperties.Name="Standardwerte wiederherstellen" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ============================== Fußleiste ============================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Fotobox+ beenden" Command="{Binding ExitCommand}"
                    Style="{StaticResource DangerButton}" VerticalAlignment="Bottom" />

            <Border Grid.Column="1" Margin="16,0" Background="{DynamicResource DangerSoftBrush}" CornerRadius="10"
                    Padding="14,8" MaxHeight="110" VerticalAlignment="Bottom"
                    Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource DangerBrush}"
                               FontSize="13.5" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Abbrechen" Command="{Binding CancelCommand}" />
                <Button Content="Speichern" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0" MinWidth="140" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
