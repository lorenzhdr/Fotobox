                                                         AutomationProperties.Name="Mausradzeile: Pfeile">
                                                <StackPanel>
                                                    <local:WheelHintSketch Kind="Arrows" />
                                                    <TextBlock Text="Pfeile" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
