                                             IsChecked="{Binding HintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:HintStyle.Cinema}}"
                                             AutomationProperties.Name="Kino">
                                    <StackPanel>
                                        <local:HintStyleSketch Kind="Cinema" />
                                        <TextBlock Text="Kino" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Filmstreifen mit goldener Schrift." Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- Mausradzeile (Layoutwahl per Mausrad) -->
