                                <StackPanel>
                                    <TextBlock Text="Mausradzeile" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Kleine Zeile unter dem Foto-Hinweis, die auf den Layoutwechsel per Mausrad hinweist. Erscheint nur, wenn im Tab „Layout“ mindestens zwei Layouts für Gäste ausgewählt sind." />
                                    <CheckBox Content="Mausradzeile anzeigen" IsChecked="{Binding ShowWheelHint}" Margin="0,14,0,0" />

                                    <StackPanel x:Name="WheelHintPanel" IsEnabled="{Binding ShowWheelHint}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="Text der Mausradzeile" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding WheelHintText, UpdateSourceTrigger=PropertyChanged}" MaxLength="{x:Static core:SettingsLimits.HintTextMaxLength}"
                                                 Width="620" HorizontalAlignment="Left" AutomationProperties.Name="Text der Mausradzeile" />
