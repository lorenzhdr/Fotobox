                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="HintStyle" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding HintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:HintStyle.Ticker}}"
                                             AutomationProperties.Name="Laufschrift">
                                    <StackPanel>
                                        <local:HintStyleSketch Kind="Ticker" />
