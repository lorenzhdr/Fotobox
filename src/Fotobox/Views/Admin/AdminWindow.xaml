                                                    <TextBlock Text="Halbtransparent, mit Schatten." Style="{StaticResource Hint}" TextAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton GroupName="WheelHintStyle" Style="{StaticResource CardRadio}"
                                                         IsChecked="{Binding WheelHintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:WheelHintStyle.Chip}}"
                                                         AutomationProperties.Name="Mausradzeile: Chip">
