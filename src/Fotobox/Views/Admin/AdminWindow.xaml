                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="VideoHintStyle" Style="{StaticResource CardRadio}"
                                                     IsChecked="{Binding VideoHintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:HintStyle.Neon}}"
                                                     AutomationProperties.Name="Video-Hinweis: Neon">
                                            <StackPanel>
                                                <local:HintStyleSketch Kind="Neon" AtTop="True" />
                                                <TextBlock Text="Neon" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                <TextBlock Text="Leuchtende Schrift in Pink und Türkis." Style="{StaticResource Hint}" TextAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="VideoHintStyle" Style="{StaticResource CardRadio}"
                                                     IsChecked="{Binding VideoHintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:HintStyle.Bubble}}"
                                                     AutomationProperties.Name="Video-Hinweis: Sprechblase">
                                            <StackPanel>
                                                <local:HintStyleSketch Kind="Bubble" AtTop="True" />
                                                <TextBlock Text="Sprechblase" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                <TextBlock Text="Weiße Blase mit Spitze, wippt leicht." Style="{StaticResource Hint}" TextAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="VideoHintStyle" Style="{StaticResource CardRadio}"
                                                     IsChecked="{Binding VideoHintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:HintStyle.Ticker}}"
                                                     AutomationProperties.Name="Video-Hinweis: Laufschrift">
                                            <StackPanel>
                                                <local:HintStyleSketch Kind="Ticker" AtTop="True" />
                                                <TextBlock Text="Laufschrift" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                <TextBlock Text="Einzeilig, läuft über ein dunkles Band." Style="{StaticResource Hint}" TextAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="VideoHintStyle" Style="{StaticResource CardRadio}"
                                                     IsChecked="{Binding VideoHintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:HintStyle.Glass}}"
                                                     AutomationProperties.Name="Video-Hinweis: Glas">
                                            <StackPanel>
                                                <local:HintStyleSketch Kind="Glass" AtTop="True" />
                                                <TextBlock Text="Glas" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                <TextBlock Text="Durchscheinende helle Karte." Style="{StaticResource Hint}" TextAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="VideoHintStyle" Style="{StaticResource CardRadio}"
                                                     IsChecked="{Binding VideoHintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:HintStyle.Note}}"
                                                     AutomationProperties.Name="Video-Hinweis: Zettel">
                                            <StackPanel>
                                                <local:HintStyleSketch Kind="Note" AtTop="True" />
                                                <TextBlock Text="Zettel" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                <TextBlock Text="Schiefer Notizzettel mit Klebestreifen." Style="{StaticResource Hint}" TextAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="VideoHintStyle" Style="{StaticResource CardRadio}"
                                                     IsChecked="{Binding VideoHintStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:HintStyle.Cinema}}"
                                                     AutomationProperties.Name="Video-Hinweis: Kino">
                                            <StackPanel>
                                                <local:HintStyleSketch Kind="Cinema" AtTop="True" />
                                                <TextBlock Text="Kino" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                <TextBlock Text="Filmstreifen mit goldener Schrift." Style="{StaticResource Hint}" TextAlignment="Center" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Vorschau" Style="{StaticResource FieldLabel}" />
                            <!-- Die Gastansicht im Maßstab 1:3 (1920 × 1080): derselbe Hinweis wie am Gerät, mit angedeutetem Livebild -->
                            <Border Width="642" Height="362" HorizontalAlignment="Left" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    AutomationProperties.Name="Vorschau der Gastansicht">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="1920" Height="1080" ClipToBounds="True">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#566077" Offset="0" />
                                                <GradientStop Color="#232A3B" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <!-- Angedeutete Person als Platzhalter für das Livebild -->
                                        <Ellipse Width="270" Height="270" Fill="#2EFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,170,0,0" />
                                        <Ellipse Width="780" Height="620" Fill="#2EFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,470,0,0" />
                                        <!-- Wie in der Gastansicht: dezenter Verlauf unten für die Lesbarkeit -->
                                        <Border VerticalAlignment="Bottom" Height="320">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0" />
                                                    <GradientStop Color="#B0000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <booth:GuestHint Text="{Binding HintPreviewText}" HintStyle="{Binding HintStyle}"
                                                         LayoutHintText="{Binding HintPreviewLayoutText}" ShowLayoutHint="{Binding ShowWheelHintPreview}"
                                                         LayoutHintStyle="{Binding WheelHintStyle}" />
                                        <!-- Video-Zeile oben im Bild (nur bei aktivem Videomodus und vorhandener Starttaste) -->
                                        <booth:GuestHint Text="{Binding VideoHintPreviewText}" HintStyle="{Binding VideoHintStyle}"
                                                         Position="Top" x:Name="VideoHintPreview"
                                                         Visibility="{Binding ShowVideoHintPreview, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Viewbox>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Die Vorschau zeigt den Hinweis mit den aktuell eingestellten Fototasten (Tab „Tasten“) und, wenn Gäste per Mausrad zwischen mehreren Layouts wählen können, die Zeile zur Layoutwahl. Bei aktivem Videomodus erscheint oben die Video-Zeile. Das Livebild ist nur angedeutet." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Darstellung ============================== -->
            <TabItem Header="Darstellung" Tag="&#xE790;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="Darstellung" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Monitor der Gastansicht" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}"
                                      DisplayMemberPath="Display" IsEnabled="{Binding IsMonitorSelectable}"
                                      AutomationProperties.Name="Monitor der Gastansicht" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding MonitorHint}"
                                       Visibility="{Binding HasMonitorHint, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="Farbschema der Einstellungen" Style="{StaticResource FieldLabel}" />
                            <!-- Die Skizzen zeigen das jeweilige Schema und sind deshalb fest eingefärbt. -->
                            <UniformGrid Columns="3" Margin="0,0,-14,0">
                                <RadioButton GroupName="AdminTheme" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding IsAdminThemeSystem}"
                                             AutomationProperties.Name="Wie Windows">
                                    <StackPanel>
                                        <Grid Width="120" Height="68">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F3F5F9" BorderBrush="#9AA5B5" BorderThickness="1.5,1.5,0,1.5"
                                                    CornerRadius="4,0,0,4" Padding="8,10,4,10">
                                                <StackPanel>
                                                    <Border Height="5" Background="#1B2430" CornerRadius="2" Margin="0,0,10,6" />
                                                    <Border Height="5" Background="#2563EB" CornerRadius="2" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#14171D" BorderBrush="#9AA5B5" BorderThickness="0,1.5,1.5,1.5"
                                                    CornerRadius="0,4,4,0" Padding="4,10,8,10">
                                                <StackPanel>
                                                    <Border Height="5" Background="#E6EAF0" CornerRadius="2" Margin="0,0,10,6" />
                                                    <Border Height="5" Background="#4C8DFF" CornerRadius="2" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Wie Windows" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Folgt dem App-Modus von Windows." Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="AdminTheme" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding IsAdminThemeLight}"
                                             AutomationProperties.Name="Hell">
                                    <StackPanel>
                                        <Border Width="120" Height="68" Background="#F3F5F9" BorderBrush="#9AA5B5" BorderThickness="1.5"
                                                CornerRadius="4" Padding="10">
                                            <StackPanel>
                                                <Border Height="5" Background="#1B2430" CornerRadius="2" Margin="0,0,40,6" />
                                                <Border Height="5" Background="#5F6B7C" CornerRadius="2" Margin="0,0,20,6" />
                                                <Border Height="5" Background="#2563EB" CornerRadius="2" Margin="0,0,56,0" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Hell" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Immer helles Schema." Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="AdminTheme" Style="{StaticResource CardRadio}"
                                             IsChecked="{Binding IsAdminThemeDark}"
                                             AutomationProperties.Name="Dunkel">
                                    <StackPanel>
                                        <Border Width="120" Height="68" Background="#14171D" BorderBrush="#9AA5B5" BorderThickness="1.5"
                                                CornerRadius="4" Padding="10">
                                            <StackPanel>
                                                <Border Height="5" Background="#E6EAF0" CornerRadius="2" Margin="0,0,40,6" />
                                                <Border Height="5" Background="#A3ADBC" CornerRadius="2" Margin="0,0,20,6" />
                                                <Border Height="5" Background="#4C8DFF" CornerRadius="2" Margin="0,0,56,0" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Dunkel" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Immer dunkles Schema." Style="{StaticResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Das Farbschema gilt für die Einstellungen und die PIN-Abfrage, nicht für die Gastansicht. Die Änderung ist sofort sichtbar und wird mit „Übernehmen“ oder „Speichern &amp; schließen“ gespeichert." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Drucker ============================== -->
            <TabItem Header="Drucker" Tag="&#xE749;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="Drucker" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Drucker" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                                      DisplayMemberPath="Display" />

                            <TextBlock Text="Papiergröße" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding SelectedPaper}"
                                      DisplayMemberPath="Display" />
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                                <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"
                                           Text="Für randlosen Druck wählen Sie hier die randlose Papiergröße Ihres Fotodruckers (zum Beispiel „10 x 15 cm randlos“)." />
                            </Border>

                            <TextBlock Text="Ausrichtung" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding SelectedOrientation}"
                                      DisplayMemberPath="Display" />

                            <TextBlock Text="Anzahl der Kopien" Style="{StaticResource FieldLabel}" />
                            <local:NumberStepper Value="{Binding Copies}" Minimum="{x:Static core:SettingsLimits.CopiesMin}" Maximum="{x:Static core:SettingsLimits.CopiesMax}" Suffix=" ×" />

                            <TextBlock Text="Zeitlimit für den Druck" Style="{StaticResource FieldLabel}" />
                            <local:NumberStepper Value="{Binding PrintTimeoutSeconds}" Minimum="{x:Static core:SettingsLimits.PrintTimeoutMin}" Maximum="{x:Static core:SettingsLimits.PrintTimeoutMax}" Step="10" Suffix=" s" />
                            <TextBlock Text="Nach dieser Zeit meldet die Fotobox einen Druckfehler und ist wieder bereit."
                                       Style="{StaticResource Hint}" />
                            <TextBlock Text="{Binding PrintTimeoutHint}" Style="{StaticResource Hint}" Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding HasPrintTimeoutHint, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="Testdruck" Style="{StaticResource FieldLabel}" Margin="0,26,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Testseite drucken" Command="{Binding TestPrintCommand}" Style="{StaticResource PrimaryButton}" />
                                <TextBlock Text="{Binding TestPrintStatus}" VerticalAlignment="Center" Margin="16,0,0,0"
                                           FontSize="14" TextWrapping="Wrap" MaxWidth="360" />
                            </StackPanel>
                            <TextBlock Text="Druckt eine Testseite mit Rahmen und Raster in der gewählten Papiergröße (mit den aktuellen, noch nicht gespeicherten Einstellungen)."
                                       Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Tasten ============================== -->
            <TabItem Header="Tasten" Tag="&#xE765;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Tasten" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Legen Sie fest, mit welchen Tasten die Fotobox bedient wird. Jede Taste kann nur einer Aktion zugeordnet werden; nur „Video starten“ und „Video beenden“ dürfen sich dieselbe Taste teilen." />

                            <ItemsControl ItemsSource="{Binding KeyEditors}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12"
                                                Padding="18,14" Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource FieldLabel}" Margin="0" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" />

                                                <ItemsControl ItemsSource="{Binding Keys}" Margin="0,12,0,0" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10"
                                                                    Padding="14,2,2,2" Margin="0,0,10,8">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                                    <Button Content="&#xE711;" Command="{Binding RemoveCommand}"
                                                                            Style="{StaticResource ChipRemoveButton}"
                                                                            ToolTip="Taste entfernen" AutomationProperties.Name="Taste entfernen" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="Taste hinzufügen" Command="{Binding AddKeyCommand}"
                                                        HorizontalAlignment="Left" Margin="0,4,0,0" />

                                                <!-- Maus: gehört nur zur Aktion „Foto auslösen“ -->
                                                <StackPanel Margin="0,10,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Action}" Value="Trigger">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <CheckBox Content="Linke Maustaste löst aus"
                                                              IsChecked="{Binding DataContext.TriggerOnLeftClick, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <CheckBox Content="Rechte Maustaste löst aus"
                                                              IsChecked="{Binding DataContext.TriggerOnRightClick, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </StackPanel>

                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0"
                                                        Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"
                                                                   Text="Drücken Sie jetzt die gewünschte Taste (auch mit Strg/Alt/Umschalt) …" />
                                                        <TextBlock FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                                                                   Text="{Binding DataContext.KeyMessage, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <Button Content="Abbrechen" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                                Command="{Binding DataContext.CancelKeyCaptureCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding VideoStartKeyHint}" Style="{StaticResource Hint}" Margin="0,12,0,0"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding HasVideoStartKeyHint, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding KeyMessage}" Style="{StaticResource Hint}" Margin="0,12,0,0"
                                       Visibility="{Binding ShowKeyMessageBelow, Converter={StaticResource BoolToVis}}" />

                            <Button Content="Standard wiederherstellen" Command="{Binding ResetKeysCommand}"
                                    HorizontalAlignment="Left" Margin="0,18,0,0" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="„Foto auslösen“ und „Admin-Ansicht öffnen“ behalten immer mindestens eine Taste. Die Änderungen gelten nach „Übernehmen“ oder „Speichern &amp; schließen“." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Speicher ============================== -->
            <TabItem Header="Speicher" Tag="&#xE8B7;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="Speicher" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Speicherordner" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PhotoFolderDisplay, Mode=OneWay}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="Ändern …" Command="{Binding ChooseFolderCommand}" Margin="10,0,0,0" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Ordner öffnen" Command="{Binding OpenFolderCommand}" />
                                <Button Content="Standardordner verwenden" Command="{Binding ResetFolderCommand}" Margin="10,0,0,0" />
                            </StackPanel>

                            <CheckBox Content="Unterordner pro Tag anlegen (JJJJ-MM-TT)" IsChecked="{Binding DateSubfolder}" Margin="0,22,0,0" />
                            <CheckBox Content="Einzelne Originalfotos zusätzlich speichern" IsChecked="{Binding SaveOriginals}" />

                            <TextBlock Text="JPEG-Qualität" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="340" Minimum="{Binding Source={x:Static core:SettingsLimits.JpegQualityMin}, Mode=OneTime}"
                                        Maximum="{Binding Source={x:Static core:SettingsLimits.JpegQualityMax}, Mode=OneTime}" TickFrequency="1" SmallChange="1" LargeChange="5"
                                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                        Value="{Binding JpegQuality}" />
                                <TextBlock Text="{Binding JpegQualityText}" FontSize="16" FontWeight="SemiBold" Margin="16,0,0,0"
                                           VerticalAlignment="Center" MinWidth="60" />
                            </StackPanel>

                            <TextBlock Text="Dateipräfix" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FilePrefix, UpdateSourceTrigger=PropertyChanged}" MaxLength="{x:Static core:SettingsLimits.FilePrefixMaxLength}" MaxWidth="320"
                                     HorizontalAlignment="Left" Width="320" />
                            <TextBlock Text="Dateien heißen zum Beispiel „Fotobox+_20250101_120000.jpg“." Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Sicherheit ============================== -->
            <TabItem Header="Sicherheit" Tag="&#xE72E;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="Sicherheit" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding AdminKeysDisplay, StringFormat='Mit {0} öffnen Sie diese Einstellungen. Der Zugang ist durch eine PIN geschützt.'}"
                                       Style="{StaticResource Hint}" />

                            <TextBlock Text="{Binding Source={x:Static core:PinRules.LengthText}, StringFormat='Neue PIN ({0})'}" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="NewPinBox" PasswordChanged="OnNewPinChanged" />
                            <TextBlock Text="Neue PIN wiederholen" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="RepeatPinBox" PasswordChanged="OnRepeatPinChanged" />

                            <Button Content="PIN ändern" Command="{Binding ChangePinCommand}" Margin="0,18,0,0"
                                    HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
                            <TextBlock Text="{Binding PinStatus}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Die PIN wird sofort geändert. Haben Sie die Felder ausgefüllt und klicken auf „Übernehmen“ oder „Speichern &amp; schließen“, wird die neue PIN ebenfalls übernommen." />

                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="Standardwerte" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Setzt alle Einstellungen außer der PIN zurück. Fotos und Overlay-Dateien bleiben erhalten. Die Änderung gilt erst nach „Übernehmen“ oder „Speichern &amp; schließen“." />
                                    <Button Content="Standardwerte wiederherstellen …" Command="{Binding ResetToDefaultsCommand}"
                                            HorizontalAlignment="Left" Margin="0,14,0,0"
                                            AutomationProperties.Name="Standardwerte wiederherstellen" />
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="Einstellungen teilen" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Exportiert die aktuellen Einstellungen in eine Datei, die Sie auf einer anderen Fotobox+ importieren können. Kamera, Drucker, Speicherorte, Mikrofon, Bildschirm und das Overlay-Bild sind nicht enthalten. Ein Import ersetzt alle anderen Einstellungen im Entwurf und gilt erst nach „Übernehmen“ oder „Speichern &amp; schließen“." />
                                    <CheckBox Content="PIN mit exportieren" IsChecked="{Binding ExportIncludePin}" Margin="0,14,0,0"
                                              AutomationProperties.Name="PIN mit exportieren" />
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Exportieren …" Command="{Binding ExportSettingsCommand}"
                                                AutomationProperties.Name="Einstellungen exportieren" />
                                        <Button Content="Importieren …" Command="{Binding ImportSettingsCommand}" Margin="12,0,0,0"
                                                AutomationProperties.Name="Einstellungen importieren" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Fun ============================== -->
            <TabItem x:Name="FunTab" Header="Fun" Tag="&#xE81D;">
                <!-- Vier Seiten als Geschwister (kein verschachteltes TabControl: es erbte den Seitenleisten-Stil): Startseite mit Kacheln,
                     Personenerkennung (Zielerfassung), Peaceerkennung und Mittelfinger. Sichtbar je nach AdminViewModel.FunPage. -->
                <Grid xmlns:funconv="clr-namespace:Fotobox.Views.Converters">
                    <Grid.Resources>
                        <funconv:EnumMatchVisibilityConverter x:Key="FunPageVis" />
                        <!-- Status-Pille der Kacheln: „An“ in der Akzentfarbe, „Aus“ gedämpft -->
                        <Style x:Key="FunTileStatus" TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Padding" Value="12,4" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Child.Text, RelativeSource={RelativeSource Self}}" Value="Aus">
                                    <Setter Property="Background" Value="{DynamicResource ThumbBgBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="FunTileStatusText" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value="Aus">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>

                    <!-- Startseite -->
                    <ScrollViewer x:Name="FunStartPage" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding FunPage, Converter={StaticResource FunPageVis}, ConverterParameter={x:Static vm:FunPage.Start}}">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="Fun" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,18"
                                       Text="Wählen Sie eine Funktion, um sie einzustellen." />
                            <UniformGrid Columns="2" Margin="0,0,-16,0">
                                <Button x:Name="FunTilePersons" Style="{StaticResource FunTile}"
                                        Command="{Binding ShowFunPageCommand}" CommandParameter="{x:Static vm:FunPage.Persons}"
                                        AutomationProperties.Name="Personenerkennung">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="56" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Margin="0,14,0,16">
                                            <TextBlock Text="Personenerkennung" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Text="Zielmarkierungen über erkannten Personen im Livebild." />
                                        </StackPanel>
                                        <Grid Grid.Row="2">
                                            <Border Style="{StaticResource FunTileStatus}">
                                                <TextBlock Text="{Binding FunPersonsStatusText}" Style="{StaticResource FunTileStatusText}" />
                                            </Border>
                                            <TextBlock Text="›" FontSize="30" Foreground="{DynamicResource MutedBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-8,0,0" />
                                        </Grid>
                                    </Grid>
                                </Button>
                                <Button x:Name="FunTilePeace" Style="{StaticResource FunTile}"
                                        Command="{Binding ShowFunPageCommand}" CommandParameter="{x:Static vm:FunPage.Peace}"
                                        AutomationProperties.Name="Peaceerkennung">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="56" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="&#x270C;" FontFamily="Segoe UI Emoji" FontSize="38" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Margin="0,14,0,16">
                                            <TextBlock Text="Peaceerkennung" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Text="Verstecktes Extra: Ein Peace-Zeichen löst eine Überraschung aus." />
                                        </StackPanel>
                                        <Grid Grid.Row="2">
                                            <Border Style="{StaticResource FunTileStatus}">
                                                <TextBlock Text="{Binding PeaceStatusText}" Style="{StaticResource FunTileStatusText}" />
                                            </Border>
                                            <TextBlock Text="›" FontSize="30" Foreground="{DynamicResource MutedBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-8,0,0" />
                                        </Grid>
                                    </Grid>
                                </Button>
                                <Button x:Name="FunTileMiddleFinger" Style="{StaticResource FunTile}"
                                        Command="{Binding ShowFunPageCommand}" CommandParameter="{x:Static vm:FunPage.MiddleFinger}"
                                        AutomationProperties.Name="Mittelfinger">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="56" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="&#x1F595;" FontFamily="Segoe UI Emoji" FontSize="38" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Margin="0,14,0,16">
                                            <TextBlock Text="Mittelfinger" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Text="Hebt Bart und Selbstzerstörung auf." />
                                        </StackPanel>
                                        <Grid Grid.Row="2">
                                            <Border Style="{StaticResource FunTileStatus}">
                                                <TextBlock Text="{Binding MiddleFingerStatusText}" Style="{StaticResource FunTileStatusText}" />
                                            </Border>
                                            <TextBlock Text="›" FontSize="30" Foreground="{DynamicResource MutedBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-8,0,0" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Seite „Personenerkennung“ (bisheriger Inhalt unverändert) -->
                    <Grid x:Name="FunPersonsPage"
                          Visibility="{Binding FunPage, Converter={StaticResource FunPageVis}, ConverterParameter={x:Static vm:FunPage.Persons}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="FunPersonsBackButton" Content="←  Zurück" Command="{Binding ShowFunPageCommand}"
                                    CommandParameter="{x:Static vm:FunPage.Start}" VerticalAlignment="Center"
                                    AutomationProperties.Name="Zurück zur Fun-Übersicht" />
                            <TextBlock Text="Personenerkennung" Style="{StaticResource SectionTitle}" Margin="18,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" xmlns:conv="clr-namespace:Fotobox.Views.Converters">
                            <ScrollViewer.Resources>
                                <conv:EnumMatchConverter x:Key="EnumMatch" />
                                <!-- Rundes Farbfeld (Farbe aus Background, bewusst fest eingefärbt wie die Gastansicht); gewählt = Ring in der Akzentfarbe -->
                                <Style x:Key="FunSwatch" TargetType="RadioButton">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Margin" Value="0,0,12,0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Grid Width="44" Height="44" Background="Transparent">
                                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource AccentHoverBrush}" StrokeThickness="3" Opacity="0" />
                                                    <Ellipse Margin="6" Fill="{TemplateBinding Background}" Stroke="{DynamicResource TrackBrush}" StrokeThickness="1" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ScrollViewer.Resources>
                            <StackPanel MaxWidth="780" HorizontalAlignment="Left">

                                <!-- Zielerfassung ein/aus -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Zielerfassung" Style="{StaticResource SectionTitle}" />
                                        <CheckBox Content="Zielerfassung einschalten" IsChecked="{Binding FunEnabled}" Margin="0,12,0,0"
                                                  FontWeight="SemiBold" AutomationProperties.Name="Zielerfassung einschalten" />
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Im Leerlauf markiert die Gastansicht Personen im Livebild mit Zielboxen („TARGET 1“, „TARGET 2“ …) und blendet danach einen Text ein. Das erscheint nie im Foto oder Video. Die Erkennung kostet Rechenleistung." />
                                    </StackPanel>
                                </Border>

                                <!-- Vorschau: außerhalb des ausgegrauten Bereichs, damit man sie auch bei ausgeschalteter Zielerfassung ausprobieren kann -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Vorschau" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                                   Text="Vorschau mit den aktuellen (noch nicht gespeicherten) Einstellungen." />
                                        <!-- Gastansicht im Maßstab 1:3 (1920 × 1080): Text- und Hinweisgrößen stimmen so mit dem Gerät überein.
                                             Fest eingefärbt wie die Gastansicht-Vorschau (bewusst nicht themenabhängig). -->
                                        <Border x:Name="FunPreviewHost" Width="640" Height="360" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                Background="#14171D" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                CornerRadius="10" ClipToBounds="True" AutomationProperties.Name="Vorschau der Zielerfassung">
                                            <Viewbox Stretch="Uniform">
                                                <Grid Width="1920" Height="1080" ClipToBounds="True" Background="#14171D">
                                                    <controls:CameraPreview Camera="{Binding Camera}" Mirror="{Binding MirrorPreview}"
                                                                            Stretch="Uniform" ShowStatusOverlay="False" />
                                                    <TextBlock x:Name="FunPreviewNoCameraText" Foreground="#A3ADBC" FontSize="48" TextAlignment="Center"
                                                               TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="160,0"
                                                               Text="Keine Kamera – „Animation testen“ funktioniert trotzdem."
                                                               Visibility="{Binding FunPreviewNoCamera, Converter={StaticResource BoolToVis}}" />
                                                    <booth:TargetOverlay x:Name="FunPreviewOverlay" Fit="Uniform"
                                                                         Snapshot="{Binding FunPreview.Snapshot}" ImageWidth="{Binding FunPreview.ImageWidth}"
                                                                         ImageHeight="{Binding FunPreview.ImageHeight}" Mirror="{Binding FunPreview.Mirror}"
                                                                         BoxStyle="{Binding FunPreview.BoxStyle}" BoxColor="{Binding FunPreview.Color}"
                                                                         Animation="{Binding FunPreview.Animation}"
                                                                         LockOnMilliseconds="{Binding FunPreview.LockOnMilliseconds}"
                                                                         LockOnIntensity="{Binding FunPreview.LockOnIntensityPercent}"
                                                                         VisibleRegion="{Binding FunPreview.VisibleRegion, Mode=OneWayToSource}"
                                                                         Visibility="{Binding FunPreview.IsShown, Converter={StaticResource BoolToVis}}" />
                                                    <booth:FunText x:Name="FunPreviewText" IsShown="{Binding FunPreview.TextVisible}"
                                                                   Text="{Binding FunPreview.Text}" Position="{Binding FunPreview.TextPosition}"
                                                                   TextStyle="{Binding FunPreview.TextStyle}" HintStyle="{Binding FunPreview.TextHintStyle}"
                                                                   Color="{Binding FunPreview.Color}" />
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel x:Name="FunPreviewFooterHost" Margin="0,12,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="FunTestButton" Content="Animation testen" Command="{Binding TestFunPreviewCommand}"
                                                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" />
                                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="480">
                                                    <TextBlock x:Name="FunPreviewStatus" Text="{Binding FunPreviewStatusText}" FontSize="14"
                                                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="FunPreviewWarning" Text="{Binding FunPreviewWarningText}" FontSize="13"
                                                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding HasFunPreviewWarning, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Alles Weitere ist bei ausgeschalteter Zielerfassung ausgegraut. -->
                                <StackPanel x:Name="FunSettingsPanel" IsEnabled="{Binding FunEnabled}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Erkennung -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Erkennung" Style="{StaticResource SectionTitle}" />

                                            <TextBlock Text="Methode" Style="{StaticResource FieldLabel}" />
                                            <UniformGrid Columns="2" Margin="0,0,-14,0">
                                                <RadioButton GroupName="FunMethod" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunMethod, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:DetectionMethod.Body}}"
                                                             AutomationProperties.Name="Ganzkörper (KI-Modell)">
                                                    <StackPanel>
                                                        <TextBlock Text="Ganzkörper (KI-Modell)" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Erkennt Personen auch von der Seite oder von hinten. Braucht mehr Rechenleistung."
                                                                   Style="{StaticResource Hint}" TextAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton GroupName="FunMethod" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunMethod, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:DetectionMethod.Face}}"
                                                             AutomationProperties.Name="Gesicht (Windows)">
                                                    <StackPanel>
                                                        <TextBlock Text="Gesicht (Windows)" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Sparsam, erkennt aber nur Gesichter, die zur Kamera schauen."
                                                                   Style="{StaticResource Hint}" TextAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </UniformGrid>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Läuft die Ganzkörper-Erkennung nicht (z. B. fehlt das Modell oder es gibt ein Problem), weicht die Fotobox automatisch auf die Gesichtserkennung aus." />

                                            <TextBlock Text="Umfang der Box" Style="{StaticResource FieldLabel}" />
                                            <UniformGrid Columns="3" Margin="0,0,-14,0">
                                                <RadioButton GroupName="FunScope" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunScope, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:TargetScope.Head}}"
                                                             AutomationProperties.Name="Kopf">
                                                    <TextBlock Text="Kopf" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                                </RadioButton>
                                                <RadioButton GroupName="FunScope" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunScope, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:TargetScope.UpperBody}}"
                                                             AutomationProperties.Name="Oberkörper">
                                                    <TextBlock Text="Oberkörper" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                                </RadioButton>
                                                <RadioButton GroupName="FunScope" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunScope, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:TargetScope.FullBody}}"
                                                             AutomationProperties.Name="Ganze Person">
                                                    <TextBlock Text="Ganze Person" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                                </RadioButton>
                                            </UniformGrid>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Bei der Gesichtserkennung wird der Umfang aus dem Gesicht geschätzt." />

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Analysen pro Sekunde" Style="{StaticResource FieldLabel}" />
                                                <Button x:Name="FunAnalysesInfo" Style="{StaticResource InfoBadge}"
                                                        ToolTip="{x:Static vm:AdminInfoTexts.FunAnalysesPerSecond}"
                                                        AutomationProperties.Name="{x:Static vm:AdminInfoTexts.AnalysesPerSecondName}"
                                                        AutomationProperties.HelpText="{x:Static vm:AdminInfoTexts.FunAnalysesPerSecond}" />
                                            </StackPanel>
                                            <local:NumberStepper Value="{Binding FunAnalysesPerSecond}" Minimum="{x:Static core:SettingsLimits.FunAnalysesPerSecondMin}" Maximum="{x:Static core:SettingsLimits.FunAnalysesPerSecondMax}" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Mehr Analysen reagieren schneller, belasten den Rechner aber stärker. Das Livebild hat immer Vorrang." />

                                            <TextBlock Text="Empfindlichkeit" Style="{StaticResource FieldLabel}" />
                                            <local:NumberStepper Value="{Binding FunSensitivityPercent}" Minimum="{x:Static core:SettingsLimits.FunSensitivityMin}" Maximum="{x:Static core:SettingsLimits.FunSensitivityMax}" Step="5" Suffix=" %" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Höher erkennt mehr Personen, aber auch öfter fälschlich Dinge, die gar keine Person sind." />

                                            <TextBlock Text="Mindestgröße" Style="{StaticResource FieldLabel}" />
                                            <local:NumberStepper Value="{Binding FunMinSizePercent}" Minimum="{x:Static core:SettingsLimits.FunMinSizePercentMin}" Maximum="{x:Static core:SettingsLimits.FunMinSizePercentMax}" Step="5" Suffix=" %" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Anteil der Bildhöhe. Kleinere Personen im Hintergrund werden ignoriert." />

                                            <TextBlock Text="Höchstzahl gleichzeitiger Ziele" Style="{StaticResource FieldLabel}" />
                                            <local:NumberStepper Value="{Binding FunMaxTargets}" Minimum="{x:Static core:SettingsLimits.FunMaxTargetsMin}" Maximum="{x:Static core:SettingsLimits.FunMaxTargetsMax}" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Bei mehr Personen werden die größten markiert." />

                                            <TextBlock Text="Mindest-Verweildauer" Style="{StaticResource FieldLabel}" />
                                            <local:NumberStepper Value="{Binding FunDwellMilliseconds}" Minimum="{x:Static core:SettingsLimits.FunDwellMillisecondsMin}" Maximum="{x:Static core:SettingsLimits.FunDwellMillisecondsMax}" Step="100" Suffix=" ms" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="So lange muss eine Person im Bild erkannt sein, bevor sie anvisiert wird. Das verhindert Flackern bei kurzen Fehlerkennungen." />
                                        </StackPanel>
                                    </Border>

                                    <!-- Aussehen -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Aussehen" Style="{StaticResource SectionTitle}" />

                                            <TextBlock Text="Box-Stil" Style="{StaticResource FieldLabel}" />
                                            <!-- Die Skizzen zeigen den Stil in der gewählten Farbe und sind sonst fest eingefärbt. -->
                                            <UniformGrid Columns="3" Margin="0,0,-14,0">
                                                <RadioButton GroupName="FunBoxStyle" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunBoxStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:TargetBoxStyle.Corners}}"
                                                             AutomationProperties.Name="Ecken">
                                                    <StackPanel>
                                                        <local:TargetStyleSketch Kind="Corners" Color="{Binding FunColor}" />
                                                        <TextBlock Text="Ecken" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Vier Zielecken." Style="{StaticResource Hint}" TextAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton GroupName="FunBoxStyle" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunBoxStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:TargetBoxStyle.Rectangle}}"
                                                             AutomationProperties.Name="Rechteck">
                                                    <StackPanel>
                                                        <local:TargetStyleSketch Kind="Rectangle" Color="{Binding FunColor}" />
                                                        <TextBlock Text="Rechteck" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Geschlossener Rahmen." Style="{StaticResource Hint}" TextAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton GroupName="FunBoxStyle" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunBoxStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:TargetBoxStyle.CornersCrosshair}}"
                                                             AutomationProperties.Name="Ecken mit Fadenkreuz">
                                                    <StackPanel>
                                                        <local:TargetStyleSketch Kind="CornersCrosshair" Color="{Binding FunColor}" />
                                                        <TextBlock Text="Fadenkreuz" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Ecken mit Fadenkreuz in der Mitte." Style="{StaticResource Hint}" TextAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </UniformGrid>

                                            <TextBlock Text="Farbe" Style="{StaticResource FieldLabel}" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton GroupName="FunColor" Style="{StaticResource FunSwatch}" Background="#FF3B30"
                                                             IsChecked="{Binding FunColor, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:TargetColor.Red}}"
                                                             ToolTip="Rot" AutomationProperties.Name="Farbe: Rot" />
                                                <RadioButton GroupName="FunColor" Style="{StaticResource FunSwatch}" Background="#39FF14"
                                                             IsChecked="{Binding FunColor, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:TargetColor.Green}}"
                                                             ToolTip="Grün" AutomationProperties.Name="Farbe: Grün" />
                                                <RadioButton GroupName="FunColor" Style="{StaticResource FunSwatch}" Background="#00E5FF"
                                                             IsChecked="{Binding FunColor, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:TargetColor.Cyan}}"
                                                             ToolTip="Türkis" AutomationProperties.Name="Farbe: Türkis" />
                                                <RadioButton GroupName="FunColor" Style="{StaticResource FunSwatch}" Background="#FFD60A"
                                                             IsChecked="{Binding FunColor, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:TargetColor.Yellow}}"
                                                             ToolTip="Gelb" AutomationProperties.Name="Farbe: Gelb" />
                                                <RadioButton GroupName="FunColor" Style="{StaticResource FunSwatch}" Background="#FFFFFF"
                                                             IsChecked="{Binding FunColor, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:TargetColor.White}}"
                                                             ToolTip="Weiß" AutomationProperties.Name="Farbe: Weiß" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="Die Farbe gilt für Zielbox, Beschriftung und den Text im HUD-Stil." />

                                            <TextBlock Text="Einrast-Animation" Style="{StaticResource FieldLabel}" />
                                            <UniformGrid Columns="3" Margin="0,0,-14,0">
                                                <RadioButton GroupName="FunAnimation" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunAnimation, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:LockOnAnimation.ShrinkPulse}}"
                                                             AutomationProperties.Name="Zusammenziehen und Pulsieren">
                                                    <StackPanel>
                                                        <local:LockOnSketch Kind="ShrinkPulse" Color="{Binding FunColor}" />
                                                        <TextBlock Text="Zusammenziehen + Pulsieren" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                                        <TextBlock Text="Die Box zieht sich auf die Person zusammen." Style="{StaticResource Hint}" TextAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton GroupName="FunAnimation" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunAnimation, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:LockOnAnimation.Pulse}}"
                                                             AutomationProperties.Name="Pulsieren">
                                                    <StackPanel>
                                                        <local:LockOnSketch Kind="Pulse" Color="{Binding FunColor}" />
                                                        <TextBlock Text="Pulsieren" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                                        <TextBlock Text="Die Box erscheint und pulsiert." Style="{StaticResource Hint}" TextAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton GroupName="FunAnimation" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunAnimation, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:LockOnAnimation.ScanPulse}}"
                                                             AutomationProperties.Name="Scan-Linie und Pulsieren">
                                                    <StackPanel>
                                                        <local:LockOnSketch Kind="ScanPulse" Color="{Binding FunColor}" />
                                                        <TextBlock Text="Scan-Linie + Pulsieren" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                                        <TextBlock Text="Eine Linie scannt über die Person." Style="{StaticResource Hint}" TextAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </UniformGrid>

                                            <TextBlock Text="Dauer der Einrast-Animation" Style="{StaticResource FieldLabel}" />
                                            <local:NumberStepper Value="{Binding FunLockOnMilliseconds}" Minimum="{x:Static core:SettingsLimits.FunLockOnMillisecondsMin}" Maximum="{x:Static core:SettingsLimits.FunLockOnMillisecondsMax}" Step="{x:Static core:SettingsLimits.FunLockOnMillisecondsStep}" Suffix=" ms" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="So lange rastet die Zielmarke ein, bevor der Text erscheint. Die Mindest-Verweildauer davor (Karte Erkennung) bestimmt, wann eine Person überhaupt anvisiert wird." />

                                            <TextBlock Text="Intensität der Einrast-Animation" Style="{StaticResource FieldLabel}" />
                                            <local:NumberStepper Value="{Binding FunLockOnIntensityPercent}" Minimum="{x:Static core:SettingsLimits.FunLockOnIntensityMin}" Maximum="{x:Static core:SettingsLimits.FunLockOnIntensityMax}" Step="{x:Static core:SettingsLimits.FunLockOnIntensityStep}" Suffix=" %" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Wie auffällig das Einrasten ist: Bewegung, Leuchten, Blinken und Lautstärke der Töne. 50 % entspricht dem bisherigen Verhalten." />
                                        </StackPanel>
                                    </Border>

                                    <!-- Text -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Text" Style="{StaticResource SectionTitle}" />

                                            <TextBlock Text="Text bei einer Person" Style="{StaticResource FieldLabel}" />
                                            <Grid Width="620" HorizontalAlignment="Left">
                                                <TextBox Text="{Binding FunSingularText, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="{x:Static core:SettingsLimits.HintTextMaxLength}"
                                                         AutomationProperties.Name="Text bei einer Person" />
                                                <!-- Platzhalter: der Standardtext, solange das Feld leer ist -->
                                                <TextBlock Text="{Binding FunSingularTextPlaceholder}" IsHitTestVisible="False"
                                                           Foreground="{DynamicResource MutedBrush}" FontSize="15" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Margin="12,0,12,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FunSingularText}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <TextBlock Text="Text bei mehreren Personen" Style="{StaticResource FieldLabel}" />
                                            <Grid Width="620" HorizontalAlignment="Left">
                                                <TextBox Text="{Binding FunPluralText, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="{x:Static core:SettingsLimits.HintTextMaxLength}"
                                                         AutomationProperties.Name="Text bei mehreren Personen" />
                                                <TextBlock Text="{Binding FunPluralTextPlaceholder}" IsHitTestVisible="False"
                                                           Foreground="{DynamicResource MutedBrush}" FontSize="15" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Margin="12,0,12,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FunPluralText}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Leer lassen für den Standardtext (grau im Feld). Platzhalter: {Anzahl} steht für die Zahl der erkannten Personen." />

                                            <TextBlock Text="Position" Style="{StaticResource FieldLabel}" />
                                            <UniformGrid Columns="3" Margin="0,0,-14,0">
                                                <RadioButton GroupName="FunTextPosition" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunTextPosition, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:FunTextPosition.Center}}"
                                                             AutomationProperties.Name="Position: Mitte">
                                                    <TextBlock Text="Mitte" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                                </RadioButton>
                                                <RadioButton GroupName="FunTextPosition" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunTextPosition, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:FunTextPosition.Bottom}}"
                                                             AutomationProperties.Name="Position: Unten">
                                                    <TextBlock Text="Unten" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                                </RadioButton>
                                                <RadioButton GroupName="FunTextPosition" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunTextPosition, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:FunTextPosition.Top}}"
                                                             AutomationProperties.Name="Position: Oben">
                                                    <TextBlock Text="Oben" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                                </RadioButton>
                                            </UniformGrid>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="„Unten“ ersetzt kurz den Foto-Hinweis, „Oben“ die Video-Hinweiszeile." />

                                            <TextBlock Text="Stil" Style="{StaticResource FieldLabel}" />
                                            <UniformGrid Columns="2" Margin="0,0,-14,0">
                                                <RadioButton GroupName="FunTextStyle" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunTextStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:FunTextStyle.Hud}}"
                                                             AutomationProperties.Name="Stil: HUD (Tipp-Effekt)">
                                                    <StackPanel>
                                                        <TextBlock Text="HUD (Tipp-Effekt)" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Der Text wird Buchstabe für Buchstabe getippt, in der Farbe der Zielbox." Style="{StaticResource Hint}" TextAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton GroupName="FunTextStyle" Style="{StaticResource CardRadio}"
                                                             IsChecked="{Binding FunTextStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:FunTextStyle.Hint}}"
                                                             AutomationProperties.Name="Stil: Hinweis-Stil">
                                                    <StackPanel>
                                                        <TextBlock Text="Hinweis-Stil" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Der Text erscheint in einem der Hinweis-Stile wie im Tab „Gastansicht“." Style="{StaticResource Hint}" TextAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </UniformGrid>

                                            <StackPanel Visibility="{Binding FunHintStyleVisible, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Hinweis-Stil des Texts" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding FunHintStyles}" SelectedItem="{Binding SelectedFunHintStyle}"
                                                          DisplayMemberPath="Display" HorizontalAlignment="Left" Width="320"
                                                          AutomationProperties.Name="Hinweis-Stil des Texts" />
                                            </StackPanel>

                                            <TextBlock Text="Anzeigedauer des Texts" Style="{StaticResource FieldLabel}" />
                                            <local:NumberStepper Value="{Binding FunTextSeconds}" Minimum="{x:Static core:SettingsLimits.FunTextSecondsMin}" Maximum="{x:Static core:SettingsLimits.FunTextSecondsMax}" Suffix=" s" />

                                            <TextBlock Text="Pause bis zur nächsten Erfassung" Style="{StaticResource FieldLabel}" />
                                            <local:NumberStepper Value="{Binding FunCooldownSeconds}" Minimum="{x:Static core:SettingsLimits.FunCooldownSecondsMin}" Maximum="{x:Static core:SettingsLimits.FunCooldownSecondsMax}" Step="5" Suffix=" s" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Nach dem Text löst dieselbe Gruppe so lange nicht erneut aus. Kommt während der Pause eine weitere Person hinzu, löst die Erfassung sofort wieder aus; kommt sie, solange der Text läuft, folgt direkt nach dem Text eine eigene Meldung." />

                                            <CheckBox Content="Personentausch löst aus" IsChecked="{Binding FunSwapTriggers}" Margin="0,16,0,0"
                                                      AutomationProperties.Name="Personentausch löst aus" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Geht eine Person und kommt eine andere, zählt das als neue Person, auch wenn die Anzahl gleich bleibt." />

                                            <CheckBox Content="Bei gleicher Gruppe wiederholen" IsChecked="{Binding FunRepeatEnabled}" Margin="0,16,0,0"
                                                      AutomationProperties.Name="Bei gleicher Gruppe wiederholen" />
                                            <StackPanel IsEnabled="{Binding FunRepeatEnabled}">
                                                <TextBlock Text="Wiederholen alle" Style="{StaticResource FieldLabel}" />
                                                <local:NumberStepper Value="{Binding FunRepeatSeconds}" Minimum="{x:Static core:SettingsLimits.FunRepeatSecondsMin}" Maximum="{x:Static core:SettingsLimits.FunRepeatSecondsMax}" Step="5" Suffix=" s" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Bleibt dieselbe Gruppe im Bild, rasten alle Personen nach dieser Zeit erneut ein und der Text erscheint noch einmal. Die Zeit läuft ab dem Ende des Texts, frühestens nach der Pause." />
                                        </StackPanel>
                                    </Border>

                                    <!-- Ton -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Ton" Style="{StaticResource SectionTitle}" />
                                            <CheckBox Content="Soundeffekte (Erfassen, Einrasten, Text)" IsChecked="{Binding FunSoundEnabled}" Margin="0,12,0,0"
                                                      AutomationProperties.Name="Soundeffekte" />
                                            <TextBlock Style="{StaticResource Hint}" Text="Kurze Effekte über die Lautsprecher des Rechners." />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Seite „Peaceerkennung“ -->
                    <local:PeaceSettingsView x:Name="PeacePage"
                                             Visibility="{Binding FunPage, Converter={StaticResource FunPageVis}, ConverterParameter={x:Static vm:FunPage.Peace}}" />

                    <!-- Seite „Mittelfinger“ -->
                    <local:MiddleFingerSettingsView x:Name="MiddleFingerPage"
                                                    Visibility="{Binding FunPage, Converter={StaticResource FunPageVis}, ConverterParameter={x:Static vm:FunPage.MiddleFinger}}" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============================== Fußleiste ============================== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Fotobox+ beenden" Command="{Binding ExitCommand}"
                    Style="{StaticResource DangerButton}" VerticalAlignment="Bottom" />

            <Border Grid.Column="1" Margin="16,0" Background="{DynamicResource DangerSoftBrush}" CornerRadius="10"
                    Padding="14,8" MaxHeight="110" VerticalAlignment="Bottom"
                    Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource DangerBrush}"
                               FontSize="13.5" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- Erfolgsmeldung nach „Übernehmen“ (verschwindet bei der nächsten Änderung; nie gleichzeitig mit einem Fehler) -->
            <Border Grid.Column="1" Margin="16,0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10"
                    Padding="14,8" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Visibility="{Binding HasSaveStatus, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SaveStatusMessage}" Foreground="{DynamicResource AccentBrush}"
                           FontSize="13.5" TextWrapping="Wrap" AutomationProperties.Name="Speicherstatus" />
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Schließen" Command="{Binding CloseCommand}" />
                <Button Content="Übernehmen" Command="{Binding ApplyCommand}" Margin="10,0,0,0" />
                <Button Content="Speichern &amp; schließen" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0" MinWidth="140" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
