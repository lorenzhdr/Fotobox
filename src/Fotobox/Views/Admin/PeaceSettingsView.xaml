<UserControl x:Class="Fotobox.Views.Admin.PeaceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fotobox.Views.Admin"
             xmlns:core="clr-namespace:Fotobox.Core"
             xmlns:vm="clr-namespace:Fotobox.ViewModels.Admin"
             xmlns:conv="clr-namespace:Fotobox.Views.Converters"
             xmlns:controls="clr-namespace:Fotobox.Views.Controls"
             xmlns:peace="clr-namespace:Fotobox.Views.Booth.Peace">

    <!-- Seite „Peaceerkennung“ im Tab „Fun“. Der DataContext (AdminViewModel) wird vom Fenster geerbt. Stile und Farben des Admins
         kommen per DynamicResource aus dem Fenster (dieses Steuerelement wird beim Laden noch nicht im Fenster geparst). -->
    <UserControl.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Bereich, der bei IsEnabled=False ausgegraut wird -->
        <Style x:Key="Dim" TargetType="StackPanel">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="PeaceBackButton" Content="←  Zurück" Command="{Binding ShowFunPageCommand}"
                    CommandParameter="{x:Static vm:FunPage.Start}" VerticalAlignment="Center"
                    AutomationProperties.Name="Zurück zur Fun-Übersicht" />
            <TextBlock Text="Peaceerkennung" Style="{DynamicResource SectionTitle}" Margin="18,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left">

                <!-- Schalter -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Peaceerkennung" Style="{DynamicResource SectionTitle}" />
                        <CheckBox x:Name="PeaceEnabledCheck" Content="Peaceerkennung einschalten" IsChecked="{Binding PeaceEnabled}"
                                  Margin="0,12,0,0" FontWeight="SemiBold" AutomationProperties.Name="Peaceerkennung einschalten" />
                        <TextBlock Style="{DynamicResource Hint}"
                                   Text="Zeigt im Leerlauf jemand ein Peace-Zeichen (✌) in die Kamera und hält es kurz, wird eine der gewählten Aktionen ausgeführt. In der Gastansicht wird darauf nicht hingewiesen. Die Erkennung benötigt zusätzliche Rechenleistung." />
                    </StackPanel>
                </Border>

                <!-- Vorschau: außerhalb des ausgegrauten Bereichs, damit man sie auch bei ausgeschalteter Erkennung ausprobieren kann -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Vorschau" Style="{DynamicResource SectionTitle}" />
                        <TextBlock Style="{DynamicResource Hint}" Margin="0,2,0,0"
                                   Text="Zeigen Sie ein Peace-Zeichen in die Kamera: Die erkannten Handpunkte erscheinen im Bild. Die Vorschau nutzt die aktuellen (noch nicht gespeicherten) Einstellungen und löst nie ein echtes Foto oder einen Druck aus." />
                        <!-- Gastansicht im Maßstab 1:3 (1920 × 1080). Fest eingefärbt wie die Gastansicht (bewusst nicht themenabhängig). -->
                        <Border x:Name="PeacePreviewHost" Width="640" Height="360" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Background="#14171D" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" ClipToBounds="True" AutomationProperties.Name="Vorschau der Peaceerkennung">
                            <Viewbox Stretch="Uniform">
                                <Grid Width="1920" Height="1080" ClipToBounds="True" Background="#14171D">
                                    <controls:CameraPreview Camera="{Binding Camera}" Mirror="{Binding MirrorPreview}"
                                                            Stretch="Uniform" ShowStatusOverlay="False" />
                                    <TextBlock x:Name="PeacePreviewNoCameraText" Foreground="#A3ADBC" FontSize="48" TextAlignment="Center"
                                               TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="160,0"
                                               Text="Keine Kamera – „Selbstzerstörung testen“ und „Bart testen“ funktionieren trotzdem."
                                               Visibility="{Binding FunPreviewNoCamera, Converter={StaticResource BoolToVis}}" />
                                    <peace:PeaceOverlay x:Name="PeacePreviewOverlay" Fit="Uniform" ShowLandmarks="True" ShowHoldProgress="True"
                                                        Faces="{Binding PeacePreview.Faces}" ShowFaceLandmarks="{Binding PeacePreviewShowFacePoints}"
                                                        Moustaches="{Binding PeacePreview.Moustaches}" Hands="{Binding PeacePreview.Hands}"
                                                        ImageWidth="{Binding PeacePreview.ImageWidth}" ImageHeight="{Binding PeacePreview.ImageHeight}"
                                                        Mirror="{Binding MirrorPreview}" />
                                    <!-- Abzeichen „Peace erkannt“ -->
                                    <Border x:Name="PeaceDetectedBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="48" Padding="36,16"
                                            Background="#CC1E7B3A" CornerRadius="48"
                                            Visibility="{Binding PeacePreview.PeaceDetectedNow, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Peace erkannt ✌" Foreground="White" FontSize="54" FontWeight="SemiBold" />
                                    </Border>
                                    <!-- Aktion Foto in der Vorschau: nur ein Hinweis, nie ein echtes Foto -->
                                    <Border x:Name="PeacePhotoBadge" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="48" Padding="36,16"
                                            Background="#CC14171D" CornerRadius="48"
                                            Visibility="{Binding PeacePhotoBadgeVisible, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Foto würde ausgelöst 📷" Foreground="White" FontSize="54" FontWeight="SemiBold" />
                                    </Border>
                                    <peace:SelfDestructOverlay x:Name="PeaceSelfDestruct"
                                                               SecondsRemaining="{Binding PeaceTestSecondsRemaining}"
                                                               Visibility="{Binding PeaceTestSelfDestructVisible, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PeaceTestSelfDestructButton" Content="Selbstzerstörung testen"
                                        Command="{Binding TestSelfDestructCommand}" Style="{DynamicResource PrimaryButton}" VerticalAlignment="Top" />
                                <Button x:Name="PeaceTestMoustacheButton" Content="Bart testen" Command="{Binding TestMoustacheCommand}"
                                        Margin="10,0,0,0" VerticalAlignment="Top" />
                            </StackPanel>
                            <CheckBox x:Name="PeaceShowFacePointsCheck" Content="Gesichtspunkte anzeigen" Margin="0,12,0,0"
                                      IsChecked="{Binding PeacePreviewShowFacePoints}" AutomationProperties.Name="Gesichtspunkte anzeigen" />
                            <TextBlock Style="{DynamicResource Hint}" Margin="0,2,0,0"
                                       Text="Zeichnet Augen, Nase und Mundwinkel jedes erkannten Gesichts in die Vorschau (nur zur Kontrolle, wird nicht gespeichert)." />
                            <TextBlock x:Name="PeacePreviewStatus" Text="{Binding PeacePreviewStatusText}" FontSize="14"
                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock x:Name="PeacePreviewWarning" Text="{Binding PeacePreviewWarningText}" FontSize="13"
                                       Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding HasPeacePreviewWarning, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Alles Weitere ist bei ausgeschalteter Peaceerkennung ausgegraut. -->
                <StackPanel x:Name="PeaceSettingsPanel" IsEnabled="{Binding PeaceEnabled}" Style="{StaticResource Dim}">

                    <!-- Aktionen -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Aktionen" Style="{DynamicResource SectionTitle}" />
                            <UniformGrid Columns="3" Margin="0,12,-14,0">
                                <CheckBox x:Name="PeaceActionSelfDestructCheck" Style="{DynamicResource CardCheck}"
                                          IsChecked="{Binding PeaceActionSelfDestruct}" AutomationProperties.Name="Aktion: Selbstzerstörung">
                                    <StackPanel>
                                        <local:SelfDestructSketch />
                                        <TextBlock Text="Selbstzerstörung" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Alarm-Countdown, dann Explosion und Foto." Style="{DynamicResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="PeaceActionPhotoCheck" Style="{DynamicResource CardCheck}"
                                          IsChecked="{Binding PeaceActionPhoto}" AutomationProperties.Name="Aktion: Foto">
                                    <StackPanel>
                                        <!-- Skizze: Kamera-Symbol, fest eingefärbt -->
                                        <Border Width="120" Height="68" CornerRadius="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#3A4358" Offset="0" />
                                                    <GradientStop Color="#171C2A" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#E6EAF1"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Foto" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Foto mit eigenem Countdown." Style="{DynamicResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="PeaceActionMoustacheCheck" Style="{DynamicResource CardCheck}"
                                          IsChecked="{Binding PeaceActionMoustache}" AutomationProperties.Name="Aktion: Schnurrbart">
                                    <StackPanel>
                                        <local:MoustacheSketch StyleKind="Twirl" />
                                        <TextBlock Text="Schnurrbart" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,2" HorizontalAlignment="Center" />
                                        <TextBlock Text="Bärte im Livebild und im Foto." Style="{DynamicResource Hint}" TextAlignment="Center" />
                                    </StackPanel>
                                </CheckBox>
                            </UniformGrid>
                            <TextBlock Style="{DynamicResource Hint}"
                                       Text="Sind mehrere Aktionen angehakt, wird bei jeder Auslösung zufällig eine gewählt." />
                            <TextBlock x:Name="PeaceMoustacheUnavailableWarning" Style="{DynamicResource Hint}" Foreground="{DynamicResource WarningBrush}"
                                       Text="{Binding PeacePreviewMoustacheWarning}"
                                       Visibility="{Binding HasPeacePreviewMoustacheWarning, Converter={StaticResource BoolToVis}}" />
                            <TextBlock x:Name="PeaceNoActionWarning" Style="{DynamicResource Hint}" Foreground="{DynamicResource WarningBrush}"
                                       Text="Wählen Sie mindestens eine Aktion aus."
                                       Visibility="{Binding PeaceHasNoAction, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Auslösung -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Auslösung" Style="{DynamicResource SectionTitle}" />

                            <TextBlock Text="Haltedauer" Style="{DynamicResource FieldLabel}" />
                            <local:NumberStepper Value="{Binding PeaceHoldMilliseconds}" Minimum="{x:Static core:SettingsLimits.PeaceHoldMillisecondsMin}" Maximum="{x:Static core:SettingsLimits.PeaceHoldMillisecondsMax}" Step="{x:Static core:SettingsLimits.PeaceHoldMillisecondsStep}" Suffix=" ms" />
                            <TextBlock Style="{DynamicResource Hint}"
                                       Text="So lange muss das Peace-Zeichen gehalten werden. Länger verhindert Fehlauslösungen." />

                            <CheckBox Content="Fortschrittsring an der Hand anzeigen" IsChecked="{Binding PeaceShowHoldProgress}" Margin="0,14,0,0"
                                      AutomationProperties.Name="Fortschrittsring an der Hand anzeigen" />
                            <TextBlock Style="{DynamicResource Hint}"
                                       Text="Verrät den Gästen allerdings, dass es die Funktion gibt." />

                            <TextBlock Text="Sperrzeit" Style="{DynamicResource FieldLabel}" />
                            <local:NumberStepper Value="{Binding PeaceCooldownSeconds}" Minimum="{x:Static core:SettingsLimits.PeaceCooldownSecondsMin}" Maximum="{x:Static core:SettingsLimits.PeaceCooldownSecondsMax}" Step="5" Suffix=" s" />
                            <TextBlock Style="{DynamicResource Hint}"
                                       Text="Pause nach einer Auslösung. Zusätzlich muss die Hand erst heruntergenommen werden." />

                            <TextBlock Text="Empfindlichkeit" Style="{DynamicResource FieldLabel}" />
                            <local:NumberStepper Value="{Binding PeaceSensitivityPercent}" Minimum="{x:Static core:SettingsLimits.PeaceSensitivityMin}" Maximum="{x:Static core:SettingsLimits.PeaceSensitivityMax}" Step="5" Suffix=" %" />
                            <TextBlock Style="{DynamicResource Hint}"
                                       Text="Höher erkennt auch undeutliche Zeichen, löst aber öfter fälschlich aus." />

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Analysen pro Sekunde" Style="{DynamicResource FieldLabel}" />
                                <Button x:Name="PeaceAnalysesInfo" Style="{DynamicResource InfoBadge}"
                                        ToolTip="{x:Static vm:AdminInfoTexts.PeaceAnalysesPerSecond}"
                                        AutomationProperties.Name="{x:Static vm:AdminInfoTexts.AnalysesPerSecondName}"
                                        AutomationProperties.HelpText="{x:Static vm:AdminInfoTexts.PeaceAnalysesPerSecond}" />
                            </StackPanel>
                            <local:NumberStepper x:Name="PeaceAnalysesStepper" Value="{Binding PeaceAnalysesPerSecond}" Minimum="{x:Static core:SettingsLimits.PeaceAnalysesPerSecondMin}" Maximum="{x:Static core:SettingsLimits.PeaceAnalysesPerSecondMax}" />
                            <TextBlock Style="{DynamicResource Hint}"
                                       Text="Mehr Analysen reagieren schneller, belasten den Rechner aber stärker. Das Livebild hat immer Vorrang. Der Wert gilt auch für die Mittelfinger- und die Herzerkennung." />
                        </StackPanel>
                    </Border>

                    <!-- Selbstzerstörung -->
                    <StackPanel x:Name="PeaceSelfDestructPanel" IsEnabled="{Binding PeaceActionSelfDestruct}" Style="{StaticResource Dim}">
                        <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Selbstzerstörung" Style="{DynamicResource SectionTitle}" />
                                <TextBlock Text="Dauer" Style="{DynamicResource FieldLabel}" />
                                <local:NumberStepper Value="{Binding PeaceSelfDestructSeconds}" Minimum="{x:Static core:SettingsLimits.PeaceSelfDestructSecondsMin}" Maximum="{x:Static core:SettingsLimits.PeaceSelfDestructSecondsMax}" Suffix=" s" />
                                <TextBlock Style="{DynamicResource Hint}"
                                           Text="So lange läuft der Alarm-Countdown. Das Foto entsteht im Moment der Explosion." />
                                <CheckBox Content="Alarmton abspielen" IsChecked="{Binding PeaceSelfDestructSoundEnabled}" Margin="0,14,0,0"
                                          AutomationProperties.Name="Alarmton abspielen" />
                                <TextBlock Style="{DynamicResource Hint}" Text="Sirene, Pieptöne und Explosion über die Lautsprecher des Rechners." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Foto -->
                    <StackPanel x:Name="PeacePhotoPanel" IsEnabled="{Binding PeaceActionPhoto}" Style="{StaticResource Dim}">
                        <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Foto" Style="{DynamicResource SectionTitle}" />
                                <TextBlock Text="Countdown" Style="{DynamicResource FieldLabel}" />
                                <local:NumberStepper Value="{Binding PeacePhotoCountdownSeconds}" Minimum="{x:Static core:SettingsLimits.PeacePhotoCountdownMin}" Maximum="{x:Static core:SettingsLimits.PeacePhotoCountdownMax}" Suffix=" s" />
                                <TextBlock Style="{DynamicResource Hint}" Text="0 = sofort. Neben den Ziffern erscheint ein kleines ✌." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Schnurrbart -->
                    <StackPanel x:Name="PeaceMoustachePanel" IsEnabled="{Binding PeaceActionMoustache}" Style="{StaticResource Dim}">
                        <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Schnurrbart" Style="{DynamicResource SectionTitle}" />
                                <TextBlock Style="{DynamicResource Hint}" Margin="0,2,0,0"
                                           Text="Der Bart folgt dem Gesicht im Livebild und ist auch im gespeicherten und gedruckten Foto zu sehen (ebenso in den Originalen, falls diese zusätzlich gespeichert werden)." />

                                <TextBlock Text="Wer bekommt den Bart?" Style="{DynamicResource FieldLabel}" />
                                <UniformGrid Columns="2" Margin="0,0,-14,0">
                                    <RadioButton GroupName="PeaceMoustacheTargets" Style="{DynamicResource CardRadio}"
                                                 IsChecked="{Binding PeaceMoustacheTargets, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:MoustacheTargets.Everyone}}"
                                                 AutomationProperties.Name="Alle im Bild">
                                        <StackPanel>
                                            <TextBlock Text="Alle im Bild" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                            <TextBlock Text="Auch Personen, die später ins Bild kommen." Style="{DynamicResource Hint}" TextAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PeaceMoustacheTargets" Style="{DynamicResource CardRadio}"
                                                 IsChecked="{Binding PeaceMoustacheTargets, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:MoustacheTargets.PeaceShower}}"
                                                 AutomationProperties.Name="Nur wer Peace zeigt">
                                        <StackPanel>
                                            <TextBlock Text="Nur wer Peace zeigt" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                            <TextBlock Text="Nur die Person, die das Zeichen macht." Style="{DynamicResource Hint}" TextAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>

                                <TextBlock Text="Stil" Style="{DynamicResource FieldLabel}" />
                                <UniformGrid Columns="3" Margin="0,0,-14,0">
                                    <RadioButton GroupName="PeaceMoustacheStyle" Style="{DynamicResource CardRadio}" Margin="0,0,14,14"
                                                 IsChecked="{Binding PeaceMoustacheStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:MoustacheStyle.Random}}"
                                                 AutomationProperties.Name="Stil: Zufällig je Person">
                                        <StackPanel>
                                            <local:MoustacheSketch StyleKind="Random" />
                                            <TextBlock Text="Zufällig je Person" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PeaceMoustacheStyle" Style="{DynamicResource CardRadio}" Margin="0,0,14,14"
                                                 IsChecked="{Binding PeaceMoustacheStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:MoustacheStyle.Twirl}}"
                                                 AutomationProperties.Name="Stil: Zwirbel">
                                        <StackPanel>
                                            <local:MoustacheSketch StyleKind="Twirl" />
                                            <TextBlock Text="Zwirbel" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PeaceMoustacheStyle" Style="{DynamicResource CardRadio}" Margin="0,0,14,14"
                                                 IsChecked="{Binding PeaceMoustacheStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:MoustacheStyle.Walrus}}"
                                                 AutomationProperties.Name="Stil: Walross">
                                        <StackPanel>
                                            <local:MoustacheSketch StyleKind="Walrus" />
                                            <TextBlock Text="Walross" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PeaceMoustacheStyle" Style="{DynamicResource CardRadio}" Margin="0,0,14,14"
                                                 IsChecked="{Binding PeaceMoustacheStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:MoustacheStyle.Chevron}}"
                                                 AutomationProperties.Name="Stil: Chevron">
                                        <StackPanel>
                                            <local:MoustacheSketch StyleKind="Chevron" />
                                            <TextBlock Text="Chevron" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PeaceMoustacheStyle" Style="{DynamicResource CardRadio}" Margin="0,0,14,14"
                                                 IsChecked="{Binding PeaceMoustacheStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:MoustacheStyle.Brush}}"
                                                 AutomationProperties.Name="Stil: Pinsel">
                                        <StackPanel>
                                            <local:MoustacheSketch StyleKind="Brush" />
                                            <TextBlock Text="Pinsel" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PeaceMoustacheStyle" Style="{DynamicResource CardRadio}" Margin="0,0,14,14"
                                                 IsChecked="{Binding PeaceMoustacheStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:MoustacheStyle.Handlebar}}"
                                                 AutomationProperties.Name="Stil: Dalí">
                                        <StackPanel>
                                            <local:MoustacheSketch StyleKind="Handlebar" />
                                            <TextBlock Text="Dalí" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PeaceMoustacheStyle" Style="{DynamicResource CardRadio}" Margin="0,0,14,14"
                                                 IsChecked="{Binding PeaceMoustacheStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:MoustacheStyle.FuManchu}}"
                                                 AutomationProperties.Name="Stil: Fu Manchu">
                                        <StackPanel>
                                            <local:MoustacheSketch StyleKind="FuManchu" />
                                            <TextBlock Text="Fu Manchu" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PeaceMoustacheStyle" Style="{DynamicResource CardRadio}" Margin="0,0,14,14"
                                                 IsChecked="{Binding PeaceMoustacheStyle, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:MoustacheStyle.Horseshoe}}"
                                                 AutomationProperties.Name="Stil: Hufeisen">
                                        <StackPanel>
                                            <local:MoustacheSketch StyleKind="Horseshoe" />
                                            <TextBlock Text="Hufeisen" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>

                                <StackPanel x:Name="PeaceRandomStylesPanel" Visibility="{Binding PeaceRandomStylesVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Beim Zufall verwenden" Style="{DynamicResource FieldLabel}" />
                                    <UniformGrid Columns="3" Margin="0,0,-14,0">
                                        <CheckBox Style="{DynamicResource CardCheck}" Margin="0,0,14,14"
                                                  IsChecked="{Binding PeaceRandomTwirl}" IsEnabled="{Binding PeaceRandomTwirlEnabled}"
                                                  AutomationProperties.Name="Zufall: Zwirbel">
                                            <StackPanel>
                                                <local:MoustacheSketch StyleKind="Twirl" />
                                                <TextBlock Text="Zwirbel" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox Style="{DynamicResource CardCheck}" Margin="0,0,14,14"
                                                  IsChecked="{Binding PeaceRandomWalrus}" IsEnabled="{Binding PeaceRandomWalrusEnabled}"
                                                  AutomationProperties.Name="Zufall: Walross">
                                            <StackPanel>
                                                <local:MoustacheSketch StyleKind="Walrus" />
                                                <TextBlock Text="Walross" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox Style="{DynamicResource CardCheck}" Margin="0,0,14,14"
                                                  IsChecked="{Binding PeaceRandomChevron}" IsEnabled="{Binding PeaceRandomChevronEnabled}"
                                                  AutomationProperties.Name="Zufall: Chevron">
                                            <StackPanel>
                                                <local:MoustacheSketch StyleKind="Chevron" />
                                                <TextBlock Text="Chevron" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox Style="{DynamicResource CardCheck}" Margin="0,0,14,14"
                                                  IsChecked="{Binding PeaceRandomBrush}" IsEnabled="{Binding PeaceRandomBrushEnabled}"
                                                  AutomationProperties.Name="Zufall: Pinsel">
                                            <StackPanel>
                                                <local:MoustacheSketch StyleKind="Brush" />
                                                <TextBlock Text="Pinsel" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox Style="{DynamicResource CardCheck}" Margin="0,0,14,14"
                                                  IsChecked="{Binding PeaceRandomHandlebar}" IsEnabled="{Binding PeaceRandomHandlebarEnabled}"
                                                  AutomationProperties.Name="Zufall: Dalí">
                                            <StackPanel>
                                                <local:MoustacheSketch StyleKind="Handlebar" />
                                                <TextBlock Text="Dalí" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox Style="{DynamicResource CardCheck}" Margin="0,0,14,14"
                                                  IsChecked="{Binding PeaceRandomFuManchu}" IsEnabled="{Binding PeaceRandomFuManchuEnabled}"
                                                  AutomationProperties.Name="Zufall: Fu Manchu">
                                            <StackPanel>
                                                <local:MoustacheSketch StyleKind="FuManchu" />
                                                <TextBlock Text="Fu Manchu" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox Style="{DynamicResource CardCheck}" Margin="0,0,14,14"
                                                  IsChecked="{Binding PeaceRandomHorseshoe}" IsEnabled="{Binding PeaceRandomHorseshoeEnabled}"
                                                  AutomationProperties.Name="Zufall: Hufeisen">
                                            <StackPanel>
                                                <local:MoustacheSketch StyleKind="Horseshoe" />
                                                <TextBlock Text="Hufeisen" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                    </UniformGrid>
                                    <TextBlock Style="{DynamicResource Hint}"
                                               Text="Jede Person bekommt zufällig eine der angehakten Formen (und eine zufällige Haarfarbe). Mindestens eine Form muss angehakt bleiben." />
                                </StackPanel>

                                <TextBlock Text="Sichtbarkeit" Style="{DynamicResource FieldLabel}" />
                                <UniformGrid Columns="2" Margin="0,0,-14,0">
                                    <RadioButton GroupName="PeaceMoustacheVisibility" Style="{DynamicResource CardRadio}"
                                                 IsChecked="{Binding PeaceMoustacheVisibility, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:MoustacheVisibility.UntilPhotoOrGone}}"
                                                 AutomationProperties.Name="Bis zum nächsten Foto">
                                        <StackPanel>
                                            <TextBlock Text="Bis zum nächsten Foto" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                            <TextBlock Text="bzw. bis die Person verschwindet." Style="{DynamicResource Hint}" TextAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PeaceMoustacheVisibility" Style="{DynamicResource CardRadio}"
                                                 IsChecked="{Binding PeaceMoustacheVisibility, Converter={StaticResource EnumMatch}, ConverterParameter={x:Static core:MoustacheVisibility.FixedDuration}}"
                                                 AutomationProperties.Name="Feste Dauer">
                                        <StackPanel>
                                            <TextBlock Text="Feste Dauer" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" />
                                            <TextBlock Text="Der Bart verschwindet nach der eingestellten Zeit." Style="{DynamicResource Hint}" TextAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>

                                <StackPanel x:Name="PeaceMoustacheDurationPanel" IsEnabled="{Binding PeaceMoustacheDurationEnabled}" Style="{StaticResource Dim}">
                                    <TextBlock Text="Dauer" Style="{DynamicResource FieldLabel}" />
                                    <local:NumberStepper Value="{Binding PeaceMoustacheDurationSeconds}" Minimum="{x:Static core:SettingsLimits.PeaceMoustacheDurationMin}" Maximum="{x:Static core:SettingsLimits.PeaceMoustacheDurationMax}" Step="5" Suffix=" s" />
                                    <TextBlock Style="{DynamicResource Hint}" Text="Nur bei „Feste Dauer“ wirksam." />
                                </StackPanel>

                                <CheckBox Content="Danach automatisch ein Foto auslösen" IsChecked="{Binding PeaceMoustacheAutoPhoto}" Margin="0,18,0,0"
                                          AutomationProperties.Name="Danach automatisch ein Foto auslösen" />
                                <StackPanel x:Name="PeaceMoustacheAutoPhotoPanel" IsEnabled="{Binding PeaceMoustacheAutoPhoto}" Style="{StaticResource Dim}">
                                    <TextBlock Text="Countdown vor dem Foto" Style="{DynamicResource FieldLabel}" />
                                    <local:NumberStepper Value="{Binding PeaceMoustacheAutoPhotoCountdownSeconds}" Minimum="{x:Static core:SettingsLimits.PeaceMoustacheAutoPhotoCountdownMin}" Maximum="{x:Static core:SettingsLimits.PeaceMoustacheAutoPhotoCountdownMax}" Suffix=" s" />
                                    <TextBlock Style="{DynamicResource Hint}" Text="0 = sofort. Neben den Ziffern erscheint ein kleines ✌." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
