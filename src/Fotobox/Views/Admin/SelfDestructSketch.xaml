<UserControl x:Class="Fotobox.Views.Admin.SelfDestructSketch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="120" Height="68" IsHitTestVisible="False" Focusable="False">

    <!-- Skizze der Selbstzerstörung: roter Alarm mit Warndreieck und Countdown. Bewusst fest eingefärbt. -->
    <Border Width="120" Height="68" CornerRadius="4" ClipToBounds="True" BorderBrush="#E0301E" BorderThickness="2">
        <Border.Background>
            <RadialGradientBrush>
                <GradientStop Color="#3A1010" Offset="0" />
                <GradientStop Color="#7A0F0F" Offset="1" />
            </RadialGradientBrush>
        </Border.Background>
        <Grid>
            <Polygon Points="17,2 32,28 2,28" Width="34" Height="30" Fill="#FF3B30" Stroke="#FFD60A" StrokeThickness="2"
                     StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" />
            <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,11,0,0" />
            <TextBlock Text="00:03" Foreground="#FF5A4A" FontFamily="Consolas" FontWeight="Bold" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" />
        </Grid>
    </Border>
</UserControl>
