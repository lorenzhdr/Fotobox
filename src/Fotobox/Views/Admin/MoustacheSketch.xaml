<UserControl x:Class="Fotobox.Views.Admin.MoustacheSketch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="120" Height="68" IsHitTestVisible="False" Focusable="False">

    <!--
        Skizze einer Bartform: dunkles Bild mit dem Bart in Hellbraun (bei „Zufällig“ alle vier klein). Die Formen kommen aus
        MoustacheShapes (eine Quelle mit Livebild und Foto). Bewusst fest eingefärbt, nicht aus den Admin-Paletten.
    -->
    <Border Width="120" Height="68" CornerRadius="4" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3A4358" Offset="0" />
                <GradientStop Color="#171C2A" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Canvas x:Name="Host" Width="120" Height="68" />
    </Border>
</UserControl>
