<UserControl x:Class="Fotobox.Views.Admin.MoustacheSketch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="120" Height="68" IsHitTestVisible="False" Focusable="False">

    <!--
        Skizze einer Bartform: Hautton-Hintergrund mit dem Bart in seiner Haartextur (bei „Zufällig“ alle sieben Formen klein in
        verschiedenen Haarfarben). Bild und Form kommen aus MoustacheTextures bzw. MoustacheShapes (eine Quelle mit Livebild und
        Foto). Bewusst fest eingefärbt, nicht aus den Admin-Paletten.
    -->
    <Border Width="120" Height="68" CornerRadius="4" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F2D2AE" Offset="0" />
                <GradientStop Color="#DCAE86" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Canvas x:Name="Host" Width="120" Height="68" />
    </Border>
</UserControl>
