<UserControl x:Class="Fotobox.Views.Booth.WheelHintSlot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fotobox.Views.Booth"
             xmlns:core="clr-namespace:Fotobox.Core"
             xmlns:conv="clr-namespace:Fotobox.Views.Converters"
             HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False">

    <!--
        Platz für die Mausradzeile bei den vier eigenen Darstellungen (WheelHintStyle ≠ Matching); „Matching“ bleibt die
        TextBlock-Zeile "LayoutHintLine" des jeweiligen Hinweis-Stils in GuestHint. Lage, Abstände und Sichtbarkeit je Stil legt
        GuestHint fest, Text, Darstellung und Sichtbarkeit kommen vom GuestHint-Vorfahren. Alle Varianten sind ruhig (ohne Animation)
        und höchstens etwa 48 Pixel hoch, damit sie unter der Hinweis-Pille Platz haben. Farben sind bewusst fest (Gastansicht).
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:EnumMatchVisibilityConverter x:Key="StyleVis" />

        <Style x:Key="WheelText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding LayoutHintText, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding ShowLayoutHint, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource BoolToVis}}">
        <!-- Kleine Pille: schmal, dunkel, dünner Goldrand -->
        <Border HorizontalAlignment="Center" Padding="22,5" CornerRadius="20" BorderThickness="1.2"
                Background="#D9101828" BorderBrush="#E59A4A"
                Visibility="{Binding LayoutHintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:WheelHintStyle.SmallPill}}">
            <TextBlock Style="{StaticResource WheelText}" Foreground="#F2FFFFFF" />
        </Border>

        <!-- Schlichter Text: halbtransparent weiß mit Schatten, etwas kleiner als die Standardzeile -->
        <TextBlock Style="{StaticResource WheelText}" HorizontalAlignment="Center" Foreground="#B3FFFFFF"
                   Visibility="{Binding LayoutHintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:WheelHintStyle.Plain}}">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.9" />
            </TextBlock.Effect>
        </TextBlock>

        <!-- Chip: kleiner heller Chip, dunkler Text, „⇅“ davor -->
        <Border HorizontalAlignment="Center" Padding="16,5,20,5" CornerRadius="18"
                Background="#EBF3F5FA"
                Visibility="{Binding LayoutHintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:WheelHintStyle.Chip}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⇅" FontFamily="Segoe UI Symbol, Segoe UI" FontSize="22" Foreground="#3B4A78"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Style="{StaticResource WheelText}" Foreground="#1B2236" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Pfeile: „‹ Text ›“ -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    Visibility="{Binding LayoutHintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:WheelHintStyle.Arrows}}">
            <StackPanel.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.9" />
            </StackPanel.Effect>
            <TextBlock Text="‹" FontSize="34" Foreground="#F5C26B" FontWeight="Bold" VerticalAlignment="Center" Margin="0,-6,16,0" />
            <TextBlock Style="{StaticResource WheelText}" Foreground="#D9FFFFFF" />
            <TextBlock Text="›" FontSize="34" Foreground="#F5C26B" FontWeight="Bold" VerticalAlignment="Center" Margin="16,-6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
