<Window x:Class="Fotobox.Views.Booth.BoothWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Fotobox.Views.Controls"
        xmlns:booth="clr-namespace:Fotobox.Views.Booth"
        Title="Fotobox"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="#0B0D14" Cursor="None"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="Gold" Color="#F5C26B" />
        <LinearGradientBrush x:Key="PillBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EE20284A" Offset="0" />
            <GradientStop Color="#EE3A1F52" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF8D98B" Offset="0" />
            <GradientStop Color="#FFE59A4A" Offset="1" />
        </LinearGradientBrush>

        <!-- Fortschrittsbalken des Drucks: Breite der Füllung = Value (0..1) der Spur. -->
        <Style x:Key="PrintProgressBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="19" Background="#40FFFFFF"
                                    BorderBrush="{StaticResource GoldBorder}" BorderThickness="2.5" />
                            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border CornerRadius="19" Margin="5" Background="{StaticResource GoldBorder}" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text pulsiert, solange die erwartete Druckzeit überschritten ist („Gleich geschafft …“). -->
        <Style x:Key="PulseWhenOverdue" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPrintOverdue}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PulseStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45"
                                                 Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Endlos-Animationen laufen nur, solange das Element wirklich sichtbar ist (IsVisible, berücksichtigt auch
            eingeklappte Eltern). Sonst liefen sie unsichtbar weiter und kosten Render-Zeit über dem Livebild.
            (Die Puls-Animation des Hinweises liegt in GuestHint.)
        -->
        <!-- Drehender Spinner (gestrichelter Kreis), läuft nur im sichtbaren Zustand. -->
        <Style x:Key="SpinnerWhenVisible" TargetType="Ellipse">
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="SpinnerStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:1.6" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinnerStoryboard" />
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Overlay, das sanft eingeblendet wird, sobald es sichtbar wird. -->
        <Style x:Key="FadeInOverlay" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, RelativeSource={RelativeSource Self}}" Value="Visible">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                 Duration="0:0:0.35" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Layout-Vorschauliste: kurz eingeblendet (150 ms), nach dem Mausrad-Schritt langsam wieder aus (300 ms).
            Bewusst nur Opacity (keine Visibility-Animation); der Container ist nie klickbar (IsHitTestVisible="False").
        -->
        <Style x:Key="LayoutListFade" TargetType="Border">
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLayoutPreviewVisible}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Schematische Skizzen der Layouts: weiße Umrisse auf dunklem Grund. -->
        <Style x:Key="SketchFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="2.5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>

        <!-- Fotofelder eines Streifens: eine Spalte, so viele Felder wie Fotos im Streifen (DataContext = LayoutOption). -->
        <Style x:Key="SketchSlots" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemsSource" Value="{Binding StripSlots}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Style="{StaticResource SketchFrame}" BorderThickness="2" Margin="2.5" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SketchSingle">
            <Border Style="{StaticResource SketchFrame}" Width="150" Height="100" />
        </DataTemplate>

        <DataTemplate x:Key="SketchStripDouble">
            <Border Style="{StaticResource SketchFrame}" Width="84" Height="100" Padding="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="0" Style="{StaticResource SketchSlots}" />
                    <!-- Schnittlinie zwischen den beiden Streifen -->
                    <Line Grid.Column="1" X1="0" X2="0" Y1="0" Y2="1" Stretch="Fill" Margin="1,0"
                          Stroke="White" StrokeThickness="1.5" StrokeDashArray="2 2" Opacity="0.7" />
                    <ItemsControl Grid.Column="2" Style="{StaticResource SketchSlots}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SketchStripSingle">
            <Border Style="{StaticResource SketchFrame}" Width="62" Height="100" Padding="4">
                <ItemsControl Style="{StaticResource SketchSlots}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SketchOverlay">
            <Grid Width="150" Height="100">
                <Border Style="{StaticResource SketchFrame}" />
                <Border Margin="14" BorderBrush="White" BorderThickness="2" CornerRadius="3" Opacity="0.85" />
                <Ellipse Width="8" Height="8" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" />
                <Ellipse Width="8" Height="8" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" />
                <Ellipse Width="8" Height="8" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5" />
                <Ellipse Width="8" Height="8" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" />
            </Grid>
        </DataTemplate>

        <!-- Wählt die Skizze passend zum Layout des Eintrags (Content = LayoutOption; Standard: ein Foto). -->
        <Style x:Key="LayoutSketch" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ContentTemplate" Value="{StaticResource SketchSingle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Layout}" Value="StripDouble">
                    <Setter Property="ContentTemplate" Value="{StaticResource SketchStripDouble}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Layout}" Value="StripSingle">
                    <Setter Property="ContentTemplate" Value="{StaticResource SketchStripSingle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Layout}" Value="Overlay">
                    <Setter Property="ContentTemplate" Value="{StaticResource SketchOverlay}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Ein Eintrag der Liste: Skizze und Name; der gewählte ist golden umrahmt, voll sichtbar und etwas größer. -->
        <DataTemplate x:Key="LayoutOptionTemplate">
            <Border x:Name="Row" Margin="0,5" Padding="22,8" CornerRadius="22" BorderThickness="3"
                    BorderBrush="Transparent" Background="Transparent" Opacity="0.4" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{Binding}" Style="{StaticResource LayoutSketch}"
                                    Width="160" Height="104" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="40" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="30,0,0,0" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="1" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GoldBorder}" />
                    <Setter TargetName="Row" Property="Background" Value="#33F5C26B" />
                    <Setter TargetName="Row" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Live-Bild -->
        <controls:CameraPreview Camera="{Binding Camera}" Mirror="{Binding MirrorPreview}" ShowStatusOverlay="False" />

        <!-- Dezenter Verlauf unten für die Lesbarkeit des Hinweises -->
        <Border VerticalAlignment="Bottom" Height="320" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#B0000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Hinweis (Pille, schlichter Text oder Band, je nach Einstellung) samt Zusatzzeile zur Layoutwahl per Mausrad -->
        <booth:GuestHint Text="{Binding HintText}" HintStyle="{Binding HintStyle}"
                         LayoutHintText="{Binding LayoutHintText}" ShowLayoutHint="{Binding ShowLayoutHint}"
                         Visibility="{Binding ShowHint, Converter={StaticResource BoolToVis}}" />

        <!-- Layout-Vorschauliste: erscheint kurz beim Drehen des Mausrads, alle Layouts untereinander, das gewählte hervorgehoben -->
        <Border x:Name="LayoutCard" Style="{StaticResource LayoutListFade}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,120" Padding="40,22" CornerRadius="36"
                Background="#E6101420" BorderBrush="#66FFFFFF" BorderThickness="2"
                IsHitTestVisible="False" AutomationProperties.Name="Layout-Auswahl">
            <ItemsControl ItemsSource="{Binding LayoutOptions}" ItemTemplate="{StaticResource LayoutOptionTemplate}"
                          Focusable="False" IsHitTestVisible="False" />
        </Border>

        <!-- Countdown -->
        <Grid Visibility="{Binding IsCountdown, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
            <Grid.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#40000000" Offset="0" />
                    <GradientStop Color="#99000000" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
            <TextBlock Text="{Binding ShotInfoText}" Foreground="{StaticResource Gold}"
                       Visibility="{Binding ShowShotInfo, Converter={StaticResource BoolToVis}}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0"
                       FontSize="56" FontWeight="SemiBold">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.8" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="CountdownBlock" Text="{Binding CountdownText}" Foreground="White"
                       FontSize="460" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </TextBlock.RenderTransform>
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#F5C26B" Opacity="0.8" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Gleich geht es weiter …" Foreground="White" FontSize="64" FontWeight="SemiBold"
                       Visibility="{Binding IsPause, Converter={StaticResource BoolToVis}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.8" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <!-- Vorschau des Layouts -->
        <Grid Style="{StaticResource FadeInOverlay}"
              Visibility="{Binding ShowResult, Converter={StaticResource BoolToVis}}">
            <Grid.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#E61B1633" Offset="0" />
                    <GradientStop Color="#F20B0D14" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="240" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Dein Foto ✨" Foreground="{StaticResource Gold}"
                       HorizontalAlignment="Center" Margin="0,40,0,0" FontSize="54" FontWeight="SemiBold" />
            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="48,24"
                    BorderBrush="White" BorderThickness="10" Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="70" ShadowDepth="14" Direction="270" Opacity="0.75" />
                </Border.Effect>
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
            </Border>

            <!-- Druck: Hinweis und Fortschrittsbalken -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="1400"
                        Margin="120,0,120,30"
                        Visibility="{Binding ShowPrintInfo, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Style="{StaticResource SpinnerWhenVisible}" Width="30" Height="30" Stroke="{StaticResource Gold}" StrokeThickness="4"
                                 StrokeDashArray="3.5 4" StrokeDashCap="Round" Margin="0,0,20,0"
                                 RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="32" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding PrintWaitText}" Style="{StaticResource PulseWhenOverdue}"
                               Foreground="{StaticResource Gold}" FontSize="34" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
                <ProgressBar Style="{StaticResource PrintProgressBar}" Value="{Binding PrintProgress, Mode=OneWay}"
                             Margin="0,26,0,0" />
            </StackPanel>
        </Grid>

        <!-- „Fertig“: eigener Bildschirm, sobald der Druck abgeschlossen ist -->
        <Grid Style="{StaticResource FadeInOverlay}"
              Visibility="{Binding ShowDone, Converter={StaticResource BoolToVis}}">
            <Grid.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#F21B1633" Offset="0" />
                    <GradientStop Color="#FA0B0D14" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1400">
                <TextBlock Text="🖨️" Foreground="White" FontSize="200" HorizontalAlignment="Center" />
                <TextBlock Text="Fertig! 🎉" Foreground="{StaticResource Gold}" FontSize="140" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="50" ShadowDepth="0" Color="#F5C26B" Opacity="0.7" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Bitte nimm dein Foto aus dem Drucker." Foreground="White" FontSize="56"
                           FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,36,0,0" />
                <!-- Druck fertig: Balken springt auf 100 % -->
                <ProgressBar Style="{StaticResource PrintProgressBar}" Value="1" Width="1100" Margin="0,48,0,0" />
            </StackPanel>
        </Grid>

        <!-- Druck abgebrochen: ruhige Meldung (kein Fehler), danach geht es zurück zum Leerlauf -->
        <Grid Style="{StaticResource FadeInOverlay}"
              Visibility="{Binding ShowPrintCancelled, Converter={StaticResource BoolToVis}}">
            <Grid.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#F21B1633" Offset="0" />
                    <GradientStop Color="#FA0B0D14" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1400">
                <TextBlock Text="🖨️" Foreground="White" FontSize="200" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding PrintCancelledTitle}" Foreground="{StaticResource Gold}" FontSize="110"
                           FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="50" ShadowDepth="0" Color="#F5C26B" Opacity="0.7" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{Binding PrintCancelledText}" Foreground="White" FontSize="56"
                           FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,36,0,0" />
            </StackPanel>
        </Grid>

        <!-- Status-Banner (Foto wird erstellt) -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48"
                Padding="40,18" CornerRadius="50" BorderThickness="2"
                Background="{StaticResource PillBackground}" BorderBrush="{StaticResource GoldBorder}"
                IsHitTestVisible="False"
                Visibility="{Binding ShowProcessingBanner, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource SpinnerWhenVisible}" Width="32" Height="32" Stroke="{StaticResource Gold}" StrokeThickness="4"
                         StrokeDashArray="3.5 4" StrokeDashCap="Round" Margin="0,0,22,0"
                         RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="34" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Fehlerkarte -->
        <Grid Style="{StaticResource FadeInOverlay}"
              Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
            <Grid.Background>
                <SolidColorBrush Color="#D90B0D14" />
            </Grid.Background>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1100" Padding="72,56"
                    CornerRadius="32" Background="#FF1B1F2E" BorderBrush="#FFE5646B" BorderThickness="3">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="10" Opacity="0.7" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Hoppla! 😕" Foreground="#FFFF8A8F" FontSize="64" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="White" FontSize="36"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,28,0,0" />
                    <TextBlock Text="Gleich geht es weiter …" Foreground="#FFB4B8C8" FontSize="26"
                               HorizontalAlignment="Center" Margin="0,32,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Kamera-Problem -->
        <Grid Style="{StaticResource FadeInOverlay}"
              Visibility="{Binding HasCameraProblem, Converter={StaticResource BoolToVis}}"
              Background="#F00B0D14">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1100">
                <TextBlock Text="📷" Foreground="White" FontSize="120" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CameraProblemTitle}" Foreground="White" FontSize="60" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="{Binding CameraProblemText}" Foreground="#FFD0D4E4" FontSize="32"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,28,0,0" />
                <TextBlock Text="Es wird automatisch erneut versucht …" Foreground="{StaticResource Gold}"
                           FontSize="26" HorizontalAlignment="Center" Margin="0,36,0,0" />
            </StackPanel>
        </Grid>

        <!-- Kamera startet -->
        <TextBlock Text="Kamera wird gestartet …" Foreground="#FFD0D4E4" FontSize="36"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                   Visibility="{Binding IsCameraStarting, Converter={StaticResource BoolToVis}}" />

        <!-- Blitz -->
        <Border x:Name="FlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Window>
