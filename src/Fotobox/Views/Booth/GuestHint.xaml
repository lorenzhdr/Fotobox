<UserControl x:Class="Fotobox.Views.Booth.GuestHint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fotobox.Views.Booth"
             xmlns:core="clr-namespace:Fotobox.Core"
             xmlns:conv="clr-namespace:Fotobox.Views.Converters"
             FontFamily="Segoe UI Variable Display, Segoe UI"
             IsHitTestVisible="False" Focusable="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Je Darstellung ein Bereich; sichtbar ist nur der zum gewählten HintStyle passende (Parameter = Enum-Wert). -->
        <conv:EnumMatchVisibilityConverter x:Key="StyleVis" />

        <SolidColorBrush x:Key="Gold" Color="#F5C26B" />
        <LinearGradientBrush x:Key="PillBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EE20284A" Offset="0" />
            <GradientStop Color="#EE3A1F52" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF8D98B" Offset="0" />
            <GradientStop Color="#FFE59A4A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#44FFFFFF" Offset="0" />
            <GradientStop Color="#26FFFFFF" Offset="1" />
        </LinearGradientBrush>
        <!-- Perforation des Kino-Streifens: Kachel aus einem abgerundeten Loch -->
        <DrawingBrush x:Key="FilmHoles" TileMode="Tile" Stretch="None"
                      Viewbox="0,0,48,26" ViewboxUnits="Absolute" Viewport="0,0,48,26" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#E6D8D2C4">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="15,6,18,14" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!--
            Hinweistext: höchstens zwei Zeilen (feste Zeilenhöhe, MaxHeight = 2 × LineHeight), zentriert, Rest wird abgeschnitten.
            Der Eingabetext ist auf 100 Zeichen begrenzt und passt bei 1920 Pixel Breite in der Regel in zwei Zeilen.
        -->
        <Style x:Key="HintTextBlock" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Text, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="MaxWidth" Value="1500" />
        </Style>

        <Style x:Key="NeonHalo" TargetType="TextBlock" BasedOn="{StaticResource HintTextBlock}">
            <Setter Property="FontSize" Value="46" />
            <Setter Property="LineHeight" Value="62" />
            <Setter Property="MaxHeight" Value="124" />
            <Setter Property="Foreground" Value="#FFFF2E97" />
        </Style>

        <!--
            Dezente Zusatzzeile: Layout per Mausrad wechseln (nur mit mehreren Wahlmöglichkeiten). Diese Textzeile ist die
            Darstellung „Passend zum Hinweis“ (WheelHintStyle.Matching); die vier anderen zeigt WheelHintSlot.
        -->
        <Style x:Key="LayoutHintLine" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding LayoutHintText, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowLayoutHint, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="True" />
                        <Condition Binding="{Binding LayoutHintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Matching" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Lage im Bild: Standard unten (Foto-Zeile), mit Position="Top" oben (Video-Zeile). Die Abstände sind auf
            1920 × 1080 ausgelegt; oben bleibt der Rand etwas kleiner, damit die Zeile über dem Bild nicht zu tief hängt.

            Dazu das Pulsieren: Endlos-Animationen nur, solange das Element wirklich sichtbar ist (IsVisible, berücksichtigt
            auch eingeklappte Eltern). Sonst liefen sie unsichtbar weiter und kosten Render-Zeit über dem Livebild.
            Start und Stopp stehen bewusst im selben Style (ohne BasedOn): StopStoryboard findet den Namen des
            BeginStoryboard nur im Namensbereich des Styles, der die Trigger besitzt, nicht in einem abgeleiteten.
            Animiert wird immer eine am Element selbst gesetzte (nicht aus dem Style stammende) Transformation bzw. ein
            solcher Effekt, weil Werte aus einem Style eingefroren und damit nicht animierbar sind.
        -->
        <Style x:Key="HintPillPlacement" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,80" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Bottom" />
                        <Condition Binding="{Binding WheelSlotActive, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Margin" Value="0,0,0,92" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Top">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Margin" Value="0,60,0,0" />
                </DataTrigger>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="HintPillPulseStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="1" To="1.05" Duration="0:0:1.1">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="1" To="1.05" Duration="0:0:1.1">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.85" To="1" Duration="0:0:1.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="HintPillPulseStoryboard" />
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlainHintPlacement" TargetType="TextBlock" BasedOn="{StaticResource HintTextBlock}">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="40,0,40,80" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Bottom" />
                        <Condition Binding="{Binding WheelSlotActive, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Margin" Value="40,0,40,90" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Top">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Margin" Value="40,60,40,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BannerPlacement" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Padding" Value="60,30,60,36" />
            <Setter Property="BorderThickness" Value="0,3,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Top">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Padding" Value="60,30,60,30" />
                    <Setter Property="BorderThickness" Value="0,0,0,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Neon: das Pink-Leuchten (Effekt am Grid selbst, Grundwert 0,8) pulsiert zwischen 0,6 und 1, solange es sichtbar ist -->
        <Style x:Key="NeonPlacement" TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,80" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Bottom" />
                        <Condition Binding="{Binding WheelSlotActive, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Margin" Value="0,0,0,90" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Top">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Margin" Value="0,60,0,0" />
                </DataTrigger>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="NeonGlowStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                 From="0.6" To="1" Duration="0:0:1.4">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="NeonGlowStoryboard" />
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sprechblase: wippt sanft auf und ab (TranslateY ±6 px); die Spitze zeigt zur Bildmitte: nach oben (Foto-Zeile unten) bzw. nach unten (Video-Zeile oben) -->
        <Style x:Key="BubblePlacement" TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,88" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Bottom" />
                        <Condition Binding="{Binding WheelSlotActive, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Margin" Value="0,0,0,94" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Top">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Margin" Value="0,60,0,0" />
                </DataTrigger>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="BubbleBobStoryboard">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="-6" To="6" Duration="0:0:1.2">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="BubbleBobStoryboard" />
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BubbleTailUp" TargetType="Path">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Top">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BubbleTailDown" TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Top">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Laufschrift: Band wie das Banner (Goldkante oben bzw. unten); der Text läuft per Code (GuestHint.xaml.cs) -->
        <Style x:Key="TickerPlacement" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Padding" Value="0,26,0,32" />
            <Setter Property="BorderThickness" Value="0,3,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Top">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Padding" Value="0,26,0,26" />
                    <Setter Property="BorderThickness" Value="0,0,0,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Glas und Zettel: schwebende Karte wie die Pille, ohne Animation -->
        <Style x:Key="FloatingPlacement" TargetType="FrameworkElement">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,80" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Bottom" />
                        <Condition Binding="{Binding WheelSlotActive, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Margin" Value="0,0,0,90" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Top">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Margin" Value="0,60,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Der Zettel ragt durch Drehung und Klebestreifen etwas über seinen Rahmen hinaus -->
        <Style x:Key="NotePlacement" TargetType="Grid" BasedOn="{StaticResource FloatingPlacement}">
            <Setter Property="Margin" Value="0,0,0,96" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Bottom" />
                        <Condition Binding="{Binding WheelSlotActive, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Margin" Value="0,0,0,102" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Top">
                    <Setter Property="Margin" Value="0,76,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Kino: Band über die volle Breite am unteren bzw. oberen Rand -->
        <Style x:Key="CinemaPlacement" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource AncestorType=local:GuestHint}}" Value="Top">
                    <Setter Property="VerticalAlignment" Value="Top" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Pille: Rahmen, Farbverlauf, goldener Schimmer und sanftes Pulsieren -->
        <Grid Visibility="{Binding HintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:HintStyle.Pill}}">
            <Border Style="{StaticResource HintPillPlacement}" HorizontalAlignment="Center"
                    Padding="56,22" CornerRadius="60" BorderThickness="2.5"
                    Background="{StaticResource PillBackground}" BorderBrush="{StaticResource GoldBorder}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#F5C26B" Opacity="0.45" />
                </Border.Effect>
                <TextBlock Style="{StaticResource HintTextBlock}" FontSize="38" LineHeight="52" MaxHeight="104" />
            </Border>
            <TextBlock Style="{StaticResource LayoutHintLine}" VerticalAlignment="Bottom" Margin="0,0,0,30" />
            <local:WheelHintSlot VerticalAlignment="Bottom" Margin="0,0,0,26" />
        </Grid>

        <!-- Schlicht: weißer Text mit kräftigem dunklem Schatten, ohne Rahmen und Hintergrund -->
        <Grid Visibility="{Binding HintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:HintStyle.Plain}}">
            <TextBlock Style="{StaticResource PlainHintPlacement}" FontSize="42" LineHeight="56" MaxHeight="112"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.95" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Style="{StaticResource LayoutHintLine}" Foreground="#B3FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,30">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
            <local:WheelHintSlot VerticalAlignment="Bottom" Margin="0,0,0,26" />
        </Grid>

        <!-- Banner: dunkles Band über die volle Breite am unteren Rand mit dünner goldener Oberkante -->
        <Grid Visibility="{Binding HintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:HintStyle.Banner}}">
            <Border Style="{StaticResource BannerPlacement}" Background="#CC101828"
                    BorderBrush="{StaticResource Gold}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HintTextBlock}" FontSize="48" LineHeight="64" MaxHeight="128"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource LayoutHintLine}" Margin="0,12,0,0" />
                    <local:WheelHintSlot Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!--
            Neon: hell rosa getönte Schrift mit türkiser Leuchtröhre darunter; das kräftig pinke, sanft pulsierende Leuchten
            (Effekt am Grid) umgibt beides. Zweiter Effekt ist nur das türkise Glimmen der passenden Mausradzeile.
        -->
        <Grid Visibility="{Binding HintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:HintStyle.Neon}}">
            <Grid Style="{StaticResource NeonPlacement}">
                <Grid.Effect>
                    <DropShadowEffect Color="#FFFF2E97" BlurRadius="26" ShadowDepth="0" Opacity="0.8" />
                </Grid.Effect>
                <StackPanel>
                    <Grid>
                        <!-- Pinker Saum: vier um 2 px versetzte Kopien hinter der Schrift verdichten das Leuchten (ohne weiteren Effekt) -->
                        <TextBlock Style="{StaticResource NeonHalo}"><TextBlock.RenderTransform><TranslateTransform X="-2" Y="0" /></TextBlock.RenderTransform></TextBlock>
                        <TextBlock Style="{StaticResource NeonHalo}"><TextBlock.RenderTransform><TranslateTransform X="2" Y="0" /></TextBlock.RenderTransform></TextBlock>
                        <TextBlock Style="{StaticResource NeonHalo}"><TextBlock.RenderTransform><TranslateTransform X="0" Y="-2" /></TextBlock.RenderTransform></TextBlock>
                        <TextBlock Style="{StaticResource NeonHalo}"><TextBlock.RenderTransform><TranslateTransform X="0" Y="2" /></TextBlock.RenderTransform></TextBlock>
                        <TextBlock Style="{StaticResource HintTextBlock}" FontSize="46" LineHeight="62" MaxHeight="124"
                                   Foreground="#FFFFE4F4" />
                    </Grid>
                    <Border Height="4" Margin="30,10,30,0" CornerRadius="2" Background="#FF35F2FF" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource LayoutHintLine}" Foreground="#FF35F2FF" VerticalAlignment="Bottom" Margin="0,0,0,30">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF35F2FF" BlurRadius="14" ShadowDepth="0" Opacity="0.8" />
                </TextBlock.Effect>
            </TextBlock>
            <local:WheelHintSlot VerticalAlignment="Bottom" Margin="0,0,0,26" />
        </Grid>

        <!-- Sprechblase: weiße Blase mit Spitze zur Bildmitte, wippt leicht -->
        <Grid Visibility="{Binding HintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:HintStyle.Bubble}}">
            <Grid Style="{StaticResource BubblePlacement}">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.4" />
                </Grid.Effect>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Path Grid.Row="0" Style="{StaticResource BubbleTailUp}" Fill="White" HorizontalAlignment="Center"
                      Margin="0,0,0,-1" Data="M16,0 L44,26 L0,26 Z" />
                <Border Grid.Row="1" Background="White" CornerRadius="42" Padding="52,20">
                    <TextBlock Style="{StaticResource HintTextBlock}" FontSize="38" LineHeight="52" MaxHeight="104"
                               Foreground="#FF1B2236" />
                </Border>
                <Path Grid.Row="2" Style="{StaticResource BubbleTailDown}" Fill="White" HorizontalAlignment="Center"
                      Margin="0,-1,0,0" Data="M0,0 L44,0 L28,26 Z" />
            </Grid>
            <TextBlock Style="{StaticResource LayoutHintLine}" VerticalAlignment="Bottom" Margin="0,0,0,30" />
            <local:WheelHintSlot VerticalAlignment="Bottom" Margin="0,0,0,26" />
        </Grid>

        <!-- Laufschrift: dunkles Band mit Goldkante, der Text (eine Zeile) läuft endlos von rechts nach links -->
        <Grid Visibility="{Binding HintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:HintStyle.Ticker}}">
            <Border Style="{StaticResource TickerPlacement}" Background="#CC101828"
                    BorderBrush="{StaticResource Gold}">
                <StackPanel>
                    <Canvas x:Name="TickerCanvas" Height="64" ClipToBounds="True">
                        <TextBlock x:Name="TickerText" Foreground="White" FontSize="48" FontWeight="SemiBold"
                                   TextWrapping="NoWrap" LineHeight="64" LineStackingStrategy="BlockLineHeight">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                    <TextBlock Style="{StaticResource LayoutHintLine}" Margin="0,12,0,0" />
                    <local:WheelHintSlot Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Glas: halbtransparente helle Karte mit dünnem weißem Rand (ohne Hintergrundunschärfe) -->
        <Grid Visibility="{Binding HintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:HintStyle.Glass}}">
            <Border Style="{StaticResource FloatingPlacement}" Padding="52,22" CornerRadius="28" BorderThickness="1.5"
                    Background="{StaticResource GlassBackground}" BorderBrush="#80FFFFFF">
                <TextBlock Style="{StaticResource HintTextBlock}" FontSize="38" LineHeight="52" MaxHeight="104">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.7" />
                    </TextBlock.Effect>
                </TextBlock>
            </Border>
            <TextBlock Style="{StaticResource LayoutHintLine}" VerticalAlignment="Bottom" Margin="0,0,0,30">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.8" />
                </TextBlock.Effect>
            </TextBlock>
            <local:WheelHintSlot VerticalAlignment="Bottom" Margin="0,0,0,26" />
        </Grid>

        <!-- Zettel: leicht schiefe cremefarbene Karte mit Klebestreifen und Handschrift -->
        <Grid Visibility="{Binding HintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:HintStyle.Note}}">
            <Grid Style="{StaticResource NotePlacement}" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform Angle="-2" />
                </Grid.RenderTransform>
                <Border Background="#FFFFF6DC" CornerRadius="4" Padding="48,30,48,26">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.45" />
                    </Border.Effect>
                    <TextBlock Style="{StaticResource HintTextBlock}" FontFamily="Segoe Print, Segoe UI" FontWeight="Normal"
                               FontSize="32" LineHeight="50" MaxHeight="100" Foreground="#FF2B2118" />
                </Border>
                <Rectangle Width="130" Height="34" Fill="#A6E9D9A0" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,-17,0,0" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="3" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
            <TextBlock Style="{StaticResource LayoutHintLine}" VerticalAlignment="Bottom" Margin="0,0,0,30">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.8" />
                </TextBlock.Effect>
            </TextBlock>
            <local:WheelHintSlot VerticalAlignment="Bottom" Margin="0,0,0,26" />
        </Grid>

        <!-- Kino: schwarzer Filmstreifen mit Perforation oben und unten, goldene Schrift -->
        <Grid Visibility="{Binding HintStyle, RelativeSource={RelativeSource AncestorType=local:GuestHint}, Converter={StaticResource StyleVis}, ConverterParameter={x:Static core:HintStyle.Cinema}}">
            <Border Style="{StaticResource CinemaPlacement}" Background="#FF0A0A0A">
                <StackPanel>
                    <Border Height="26" Background="{StaticResource FilmHoles}" />
                    <StackPanel Margin="60,14,60,14">
                        <TextBlock Style="{StaticResource HintTextBlock}" FontSize="44" LineHeight="60" MaxHeight="120"
                                   Foreground="{StaticResource Gold}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource LayoutHintLine}" Foreground="#CCF5C26B" Margin="0,10,0,0" />
                        <local:WheelHintSlot Margin="0,20,0,0" />
                    </StackPanel>
                    <Border Height="26" Background="{StaticResource FilmHoles}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
